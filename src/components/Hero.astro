---
/**
 * Hero: fundo quadriculado, título com ícones que abrem espaço entre as palavras
 * e um bloco verde com vídeo (depois recebe site, sistema e app).
 *
 * Animação (só uma vez, ao abrir a página):
 *  1. a pílula verde depois de "Sites" se abre na horizontal e empurra o resto da linha;
 *  2. o wireframe sobe de baixo para dentro dela;
 *  3. os círculos de dinheiro e pessoas abrem espaço, um depois do outro.
 * Com "reduzir movimento" o título já aparece montado.
 */
import Button from './ui/Button.astro';
import { hero, whatsappLink } from '../content/site';
---

<section class="hero" id="topo" aria-labelledby="hero-title">
  <div class="hero__grid" aria-hidden="true"></div>

  <div class="container hero__inner">
    <h1 class="hero__title" id="hero-title">
      <span class="hero__line">
        {hero.title.before}
        <span class="t-pill" aria-hidden="true"><span><img src="/images/hero-wireframe.webp" alt="" width="360" height="240" /></span></span>
        {hero.title.middle}
        <span class="t-icons" aria-hidden="true">
          <span class="t-ico t-ico--1"><img src="/icons/hero-money.svg" alt="" width="44" height="44" /></span>
          <span class="t-ico t-ico--2"><img src="/icons/hero-users.svg" alt="" width="44" height="44" /></span>
        </span>
      </span>
      <span class="hero__line">{hero.title.after}</span>
    </h1>

    <p class="hero__lead hero-in" style="--d:3">{hero.lead}</p>

    <div class="hero__cta hero-in" style="--d:4">
      <Button href={whatsappLink()} icon="whatsapp" external>{hero.cta}</Button>
    </div>

    <div class="hero__stage hero-in" style="--d:5" id="trabalhos" aria-label={hero.stage.label} role="region">
      <video
        autoplay
        muted
        loop
        playsinline
        preload="metadata"
        poster={`${hero.stage.video}-poster.webp`}
        width="1280"
        height="532"
        aria-hidden="true"
        data-hero-video
      >
        <source src={`${hero.stage.video}.webm`} type="video/webm" />
        <source src={`${hero.stage.video}.mp4`} type="video/mp4" />
      </video>
    </div>
  </div>
</section>

<script>
  /* O vídeo para quando sai da tela e não roda para quem pediu menos movimento */
  const video = document.querySelector<HTMLVideoElement>('[data-hero-video]');
  if (video) {
    const still = matchMedia('(prefers-reduced-motion: reduce)');
    let visible = true;
    const sync = () => {
      if (still.matches || !visible || document.hidden) video.pause();
      else video.play().catch(() => {});
    };
    new IntersectionObserver(([e]) => { visible = e.isIntersecting; sync(); }).observe(video);
    document.addEventListener('visibilitychange', sync);
    still.addEventListener('change', sync);
    sync();
  }
</script>

<style>
  .hero { position: relative; padding-top: clamp(112px, 12vw, 152px); padding-bottom: clamp(28px, 4vw, 48px); isolation: isolate; }

  /* Quadriculado do layout: some aos poucos atrás do bloco verde */
  .hero__grid {
    position: absolute;
    inset: 0 0 30%;
    z-index: -1;
    background: #eeede6 url('/images/hero-grid.svg') center top / 945px 630px repeat;
    mask-image: linear-gradient(180deg, #000 70%, transparent);
    -webkit-mask-image: linear-gradient(180deg, #000 70%, transparent);
  }

  .hero__inner { display: flex; flex-direction: column; align-items: center; text-align: center; }

  .hero__title {
    font-size: clamp(2.5rem, 1.3rem + 4.6vw, 4.5rem);
    font-weight: var(--w-medium);
    line-height: 1.12;
    letter-spacing: var(--ls-display);
    color: #2a2f36;
    text-wrap: balance;
  }
  .hero__line { display: block; }

  /* Pílula verde com o wireframe de landing page dentro */
  .t-pill {
    --pw: 1.3em;
    position: relative;
    display: inline-block;
    width: var(--pw);
    height: 0.8em;
    margin-inline: 0.12em;
    vertical-align: -0.06em;
    border-radius: 999px;
    background: var(--c-green);
    box-shadow: inset 0 0 0 1px rgb(0 0 0 / 0.04);
    overflow: hidden;
  }
  .t-pill > span { position: absolute; inset: 18% 14% auto; }
  .t-pill img {
    display: block;
    width: 100%;
    height: auto;
    border-radius: 0.07em 0.07em 0 0;
    box-shadow: 0 -0.02em 0.06em rgb(0 0 0 / 0.08);
  }

  /* Dinheiro e pessoas: dois círculos, o segundo um pouco por cima do primeiro */
  .t-icons { display: inline-flex; margin-left: 0.1em; vertical-align: -0.04em; }
  .t-ico { display: inline-block; width: 0.78em; height: 0.78em; }
  .t-ico + .t-ico { margin-left: -0.16em; }
  .t-ico img { display: block; width: 100%; height: 100%; border-radius: 50%; box-shadow: 0 0 0 0.04em #eeede6; }

  @media (prefers-reduced-motion: no-preference) {
    .t-pill { animation: pill-open 0.6s var(--ease-out) 0.35s backwards; }
    .t-pill > span { animation: wire-rise 0.7s var(--ease-spring) 0.9s backwards; }
    .t-ico { animation: ico-open 0.5s var(--ease-out) backwards; }
    .t-ico img { animation: ico-pop 0.5s var(--ease-spring) backwards; }
    .t-ico--1, .t-ico--1 img { animation-delay: 1.35s; }
    .t-ico--2, .t-ico--2 img { animation-delay: 1.5s; }
  }
  @keyframes pill-open { from { width: 0; margin-inline: 0.04em; } }
  @keyframes wire-rise { from { transform: translateY(120%); } }
  @keyframes ico-open { from { width: 0; } }
  @keyframes ico-pop { from { transform: scale(0.3); opacity: 0; } }

  .hero__lead {
    max-width: 48ch;
    margin-top: 22px;
    font-size: var(--t-lg);
    line-height: 1.5;
    color: var(--c-ink-soft);
  }
  .hero__cta { margin-top: 30px; }

  /* Bloco verde com o vídeo */
  .hero__stage {
    width: min(100%, 980px);
    margin-top: clamp(40px, 5vw, 64px);
    border-radius: 24px;
    overflow: hidden;
    background: #cfe8a8;
    box-shadow: 0 30px 60px -36px rgb(45 122 27 / 0.45);
    aspect-ratio: 16 / 7;
  }
  .hero__stage video { display: block; width: 100%; height: 100%; object-fit: cover; }
  @media (max-width: 759px) {
    .hero__stage { aspect-ratio: 4 / 3; border-radius: 20px; }
  }
</style>
