---
import Button from './ui/Button.astro';
import CaseCarousel from './CaseCarousel.astro';
import Words from './ui/Words.astro';
import { hero, whatsappLink } from '../content/site';
import { splitWords } from '../lib/format';

// contagem de palavras por linha: o atraso da animação continua de uma linha para a outra
const starts = hero.titleLines.map((_, i) =>
  hero.titleLines.slice(0, i).reduce((n, line) => n + splitWords(line).length, 0),
);
const swapIndex = hero.titleLines.reduce((n, line) => n + splitWords(line).length, 0);
---

<section class="hero" id="topo" aria-labelledby="hero-title">
  <div class="container">
    <div class="hero__panel">
      <div class="hero__bg" aria-hidden="true">
        <span class="hero__beams"></span>
        <span class="hero__streak hero__streak--l"></span>
        <span class="hero__streak hero__streak--r"></span>
        <span class="hero__arc hero__arc--1"></span>
        <span class="hero__arc hero__arc--2"></span>
      </div>

      <h1 class="hero__title split split--load" id="hero-title">
        {hero.titleLines.map((line, i) => (
          <span class="hero__line"><Words text={line} from={starts[i]} icons={hero.titleIcons} /></span>
        ))}
        <span class="hero__line hero__swap">
          <span class="w" style={`--w:${swapIndex}`}><span>
            <span class="hero__phrase" data-phrase data-phrases={JSON.stringify(hero.phrases)}>{hero.fallbackPhrase}.</span>
          </span></span>
        </span>
      </h1>

      <p class="hero__lead hero-in" style="--d:5">{hero.lead}</p>

      <div class="hero__cta hero-in" style="--d:6">
        <Button href={whatsappLink()} size="lg" icon="whatsapp" external>{hero.cta}</Button>
      </div>

      <div class="hero__cases hero-in" style="--d:7"><CaseCarousel /></div>
    </div>

    <ul class="hero__proof" role="list">
      {hero.proof.map((item) => (
        <li><strong>{item.value}</strong><span>{item.label}</span></li>
      ))}
    </ul>
  </div>
</section>

<script>
  /* O fim do título passa uma vez por cada tipo de negócio e assenta em "o seu negócio." */
  const phrase = document.querySelector<HTMLElement>('[data-phrase]');
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (phrase && !reduce) {
    const final = phrase.textContent ?? '';
    const sequence = [...(JSON.parse(phrase.dataset.phrases || '[]') as string[]), final];
    const STEP = 2200;

    const swap = (text: string) => {
      phrase.classList.add('is-out');
      window.setTimeout(() => {
        phrase.textContent = text;
        phrase.classList.remove('is-out');
        phrase.classList.add('is-enter');
        void phrase.offsetWidth;
        phrase.classList.remove('is-enter');
      }, 320);
    };

    sequence.forEach((text, i) => window.setTimeout(() => swap(text), 1400 + i * STEP));
  }
</script>

<style>
  .hero { padding-top: 88px; }

  /* Bloco arredondado com luz verde suave, conteúdo centralizado */
  .hero__panel {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: clamp(56px, 8vw, 96px) clamp(16px, 4vw, 48px) 0;
    border-radius: var(--r-xl);
    background:
      radial-gradient(70% 55% at 50% 0%, rgb(94 204 66 / 0.16), transparent 70%),
      linear-gradient(180deg, #edf5e8 0%, #f1f3ee 60%, #ecebe4 100%);
    box-shadow: inset 0 0 0 1px rgb(13 15 13 / 0.05);
    text-align: center;
    overflow: hidden;
    isolation: isolate;
  }

  /* Fundo do bloco: feixes de luz do topo, pontos, faixas verdes nas laterais e um horizonte atrás dos cases */
  .hero__bg { position: absolute; inset: 0; z-index: -1; pointer-events: none; }
  .hero__bg > span { position: absolute; }
  .hero__beams {
    inset: 0 0 35%;
    background: repeating-linear-gradient(90deg, rgb(255 255 255 / 0.55) 0 1px, transparent 1px 6.25%);
    mask-image: radial-gradient(60% 90% at 50% 0%, #000 0%, transparent 75%);
    -webkit-mask-image: radial-gradient(60% 90% at 50% 0%, #000 0%, transparent 75%);
  }
  .hero__streak {
    top: 4%;
    width: 46%;
    height: 34%;
    border-radius: 50%;
    background: radial-gradient(closest-side, rgb(94 204 66 / 0.55), rgb(182 242 58 / 0.25) 55%, transparent 100%);
  }
  .hero__streak--l { left: -24%; transform: rotate(28deg); }
  .hero__streak--r { right: -24%; transform: rotate(-28deg); }
  /* Dois arcos de vidro: um passando atrás do texto, outro logo acima dos cases.
     Medidos a partir da base do bloco: altura dos cases + espaço acima deles. */
  .hero__panel { --cases-h: calc(clamp(300px, 34vw, 430px) + clamp(48px, 6vw, 72px)); }
  .hero__arc {
    left: -15%;
    right: -15%;
    height: clamp(260px, 58vw, 760px);
    border-radius: 50%;
    background: linear-gradient(180deg, rgb(255 255 255 / 0.42), rgb(255 255 255 / 0.1) 22%, rgb(255 255 255 / 0) 45%);
    box-shadow: inset 0 1px 0 rgb(255 255 255 / 0.95), 0 -24px 50px -36px rgb(255 255 255 / 0.9);
    /* EXCEÇÃO ao noise/blur-on-card: o arco é absoluto e passa por cima dos feixes e das faixas verdes; o desfoque aparece neles */
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
  }
  .hero__arc--2 { top: calc(100% - var(--cases-h) - 48px); }
  .hero__arc--1 { top: calc(100% - var(--cases-h) - clamp(100px, 10vw, 145px)); left: -18%; right: -12%; }
  @media (max-width: 759px) {
    .hero__panel { --cases-h: calc(330px + clamp(48px, 6vw, 72px)); }
  }

  /* Ícones 3D no meio do título */
  .hero__title :global(.w--icon) { vertical-align: -0.08em; }
  .hero__title :global(.w--icon > span) {
    display: inline-grid;
    place-items: center;
    width: 0.86em;
    height: 0.86em;
    border-radius: 0.22em;
    background: radial-gradient(120% 100% at 30% 0%, var(--c-green-hover), var(--c-green) 65%);
    box-shadow:
      inset 0 1px 0 rgb(255 255 255 / 0.35),
      inset 0 -0.04em 0.08em rgb(45 122 27 / 0.35),
      0 0.14em 0.32em -0.1em rgb(45 122 27 / 0.5);
  }
  .hero__title :global(.w--icon img) { width: 74%; height: 74%; object-fit: contain; filter: drop-shadow(0 0.03em 0.05em rgb(29 84 16 / 0.45)); }
  /* Entrada própria, sem desfoque: o blur da entrada das palavras deixava a pastilha sem pintar no Chrome */
  .hero__title :global(.w--icon > span) { animation-name: icon-in; animation-timing-function: var(--ease-spring); }
  @keyframes icon-in { from { opacity: 0; transform: scale(0.4); } }
  .hero__title :global(.w--icon:nth-of-type(odd) > span) { rotate: -6deg; }
  .hero__title :global(.w--icon:nth-of-type(even) > span) { rotate: 5deg; }
  /* No celular só o segundo ícone, para a primeira linha não quebrar */
  @media (max-width: 559px) {
    .hero__title .hero__line:first-child :global(.w--icon) { display: none; }
  }

  .hero__title {
    font-size: clamp(2.75rem, 11vw, 5.75rem);
    font-weight: var(--w-heavy);
    line-height: 0.98;
    letter-spacing: var(--ls-display);
  }
  @media (min-width: 760px) {
    .hero__title { font-size: clamp(3.5rem, 7vw, 5.75rem); }
  }
  .hero__line { display: block; }

  /* Última linha: troca de frase sem empurrar o layout */
  .hero__swap {
    white-space: nowrap;
    overflow: hidden;
    padding-bottom: 0.1em;
    margin-bottom: -0.1em;
  }
  .hero__phrase {
    display: inline-block;
    transition: transform 0.7s var(--ease-out), opacity 0.5s ease, filter 0.6s ease;
  }
  .hero__phrase:global(.is-out) {
    transform: translateY(-55%);
    opacity: 0;
    filter: blur(6px);
    transition-duration: 0.32s;
    transition-timing-function: var(--ease-in-out);
  }
  .hero__phrase:global(.is-enter) {
    transform: translateY(55%);
    opacity: 0;
    filter: blur(6px);
    transition: none;
  }

  .hero__lead {
    max-width: 52ch;
    margin-top: 28px;
    font-size: var(--t-lg);
    line-height: 1.55;
    color: var(--c-ink-soft);
  }
  .hero__cta { margin-top: 36px; }
  .hero__cases { align-self: stretch; }

  .hero__proof {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 12px 40px;
    padding-block: 28px 24px;
    font-size: var(--t-sm);
    color: var(--c-ink-soft);
  }
  .hero__proof li { display: flex; align-items: baseline; gap: 8px; }
  .hero__proof strong {
    font-size: 1.125rem;
    font-weight: var(--w-bold);
    letter-spacing: var(--ls-title);
    color: var(--c-ink);
  }
  @media (max-width: 559px) {
    .hero__proof { flex-direction: column; align-items: center; gap: 6px; }
  }
</style>
