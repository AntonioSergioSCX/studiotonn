---
/**
 * Ícones da biblioteca Phosphor (@phosphor-icons/core), embutidos no HTML na hora do build.
 * Decorativos: aria-hidden. Para um ícone novo, acrescente o nome do arquivo em `files`.
 */
const files = {
  arrow: 'arrow-right',
  'arrow-down': 'arrow-down',
  'arrow-up-right': 'arrow-up-right',
  whatsapp: 'whatsapp-logo',
  check: 'check',
  star: 'star',
  search: 'magnifying-glass',
  pin: 'map-pin',
  plus: 'plus',
  mail: 'envelope-simple',
  clock: 'clock',
  lock: 'lock-simple',
  file: 'file-text',
  refresh: 'arrows-clockwise',
  key: 'key',
  'caret-left': 'caret-left',
  'caret-right': 'caret-right',
  asterisk: 'asterisk',
} as const;

const svgs = import.meta.glob('/node_modules/@phosphor-icons/core/assets/regular/*.svg', {
  query: '?raw',
  import: 'default',
  eager: true,
}) as Record<string, string>;

interface Props {
  name: keyof typeof files;
  size?: number;
  class?: string;
}
const { name, size = 20, class: className } = Astro.props;
const raw = svgs[`/node_modules/@phosphor-icons/core/assets/regular/${files[name]}.svg`] ?? '';
const inner = raw.replace(/^<svg[^>]*>/, '').replace(/<\/svg>\s*$/, '');
---

<svg
  class={className}
  width={size}
  height={size}
  viewBox="0 0 256 256"
  fill="currentColor"
  aria-hidden="true"
  focusable="false"
  set:html={inner}
/>
