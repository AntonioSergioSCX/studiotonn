---
/** Ícones em SVG inline (decorativos: aria-hidden). */
interface Props {
  name: 'arrow' | 'arrow-down' | 'whatsapp' | 'check' | 'star' | 'search' | 'pin' | 'plus' | 'mail' | 'clock' | 'lock' | 'file' | 'refresh' | 'key';
  size?: number;
  class?: string;
}
const { name, size = 20, class: className } = Astro.props;
---

<svg
  class={className}
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.8"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
>
  {name === 'arrow' && <path d="M5 12h14M13 6l6 6-6 6" />}
  {name === 'arrow-down' && <path d="M12 5v14M6 13l6 6 6-6" />}
  {name === 'whatsapp' && (
    <>
      <path d="M3.5 20.5l1.3-4.2A8.5 8.5 0 1 1 8 19.4l-4.5 1.1Z" />
      <path d="M9 8.6c.2-.5.5-.6.8-.6h.5c.2 0 .4.1.5.4l.7 1.6c.1.2 0 .5-.1.6l-.5.6c-.1.2-.2.4 0 .6.6 1 1.4 1.8 2.4 2.4.2.1.4.1.6 0l.6-.5c.2-.1.4-.2.6-.1l1.6.7c.3.1.4.3.4.5v.5c0 .3-.1.6-.6.8-.5.3-1.4.5-2.6 0a9.4 9.4 0 0 1-4.8-4.8c-.5-1.2-.3-2.1 0-2.7Z" fill="currentColor" stroke="none" />
    </>
  )}
  {name === 'check' && <path d="M5 12.5l4.5 4.5L19 7.5" />}
  {name === 'star' && <path d="M12 3.5l2.6 5.3 5.9.9-4.3 4.1 1 5.8-5.2-2.7-5.2 2.7 1-5.8-4.3-4.1 5.9-.9L12 3.5Z" fill="currentColor" stroke="none" />}
  {name === 'search' && (<><circle cx="11" cy="11" r="6.5" /><path d="M16 16l4.5 4.5" /></>)}
  {name === 'pin' && (<><path d="M12 21s-6.5-5.6-6.5-11a6.5 6.5 0 0 1 13 0c0 5.4-6.5 11-6.5 11Z" /><circle cx="12" cy="10" r="2.3" /></>)}
  {name === 'plus' && <path d="M12 5v14M5 12h14" />}
  {name === 'mail' && (<><rect x="3.5" y="5.5" width="17" height="13" rx="2.5" /><path d="M4 7l8 6 8-6" /></>)}
  {name === 'clock' && (<><circle cx="12" cy="12" r="8.5" /><path d="M12 7.5V12l3 2" /></>)}
  {name === 'lock' && (<><rect x="5" y="10.5" width="14" height="10" rx="2.5" /><path d="M8.5 10.5V8a3.5 3.5 0 0 1 7 0v2.5" /></>)}
  {name === 'file' && (<><path d="M7 3.5h7l4.5 4.5v12.5H7z" /><path d="M14 3.5V8h4.5M9.5 13h6M9.5 16.5h6" /></>)}
  {name === 'refresh' && (<><path d="M19.5 12a7.5 7.5 0 1 1-2.2-5.3" /><path d="M19.5 4.5v4h-4" /></>)}
  {name === 'key' && (<><circle cx="8" cy="15" r="3.8" /><path d="M10.8 12.3L19 4.5M16 7.5l2.5 2.5" /></>)}
</svg>
