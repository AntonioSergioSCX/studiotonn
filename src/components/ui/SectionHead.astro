---
import { splitAccent } from '../../lib/format';

interface Props {
  index: string;
  eyebrow: string;
  title: string;
  lead?: string;
  id?: string;
}
const { index, eyebrow, title, lead, id } = Astro.props;
---

<header class="sh">
  <p class="sh__eyebrow" data-reveal>
    <span class="sh__index">{index}</span>
    <span class="sh__sep" aria-hidden="true">/</span>
    {eyebrow}
  </p>
  <h2 class="sh__title" id={id} data-reveal style="--i:1">
    {splitAccent(title).map((part, i) => (i % 2 ? <span class="accent">{part}</span> : part))}
  </h2>
  {lead && <p class="sh__lead" data-reveal style="--i:2">{lead}</p>}
  <slot />
</header>

<style>
  .sh {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 18px;
    margin: 0 auto clamp(40px, 6vw, 64px);
    text-align: center;
  }
  .sh__eyebrow {
    display: inline-flex;
    gap: 8px;
    align-items: baseline;
    padding: 6px 12px;
    border-radius: var(--r-pill);
    background: var(--c-surface);
    box-shadow: inset 0 0 0 1px var(--c-line);
    font-family: var(--f-mono);
    font-size: 0.75rem;
    font-weight: var(--w-medium);
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--c-ink-soft);
  }
  .sh__index { color: var(--c-green-ink); }
  .sh__sep { opacity: 0.4; }
  .sh__title {
    max-width: 18ch;
    font-size: var(--t-h2);
    font-weight: var(--w-bold);
    line-height: 1;
    letter-spacing: var(--ls-display);
  }
  .sh__lead {
    max-width: 52ch;
    font-size: var(--t-lg);
    color: var(--c-ink-soft);
  }
  :global(.on-dark) .sh__lead { color: var(--c-on-dark-soft); }
</style>
