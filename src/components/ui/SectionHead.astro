---
import Words from './Words.astro';

interface Props {
  index?: string;
  eyebrow: string;
  title: string;
  lead?: string;
  id?: string;
}
const { index, eyebrow, title, lead, id } = Astro.props;
---

<header class="sh">
  <p class="sh__eyebrow" data-reveal>
    {eyebrow}
  </p>
  <h2 class="sh__title split split--scroll" id={id} data-split>
    <Words text={title} />
  </h2>
  {lead && <p class="sh__lead" data-reveal style="--i:2">{lead}</p>}
  <slot />
</header>

<style>
  .sh {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 18px;
    margin: 0 auto clamp(40px, 6vw, 64px);
    text-align: center;
  }
  .sh__eyebrow {
    display: inline-flex;
    gap: 8px;
    align-items: baseline;
    font-size: var(--t-sm);
    font-weight: var(--w-semibold);
    color: var(--c-green-ink);
  }
  .sh__index { color: var(--c-green-ink); }
  .sh__sep { opacity: 0.4; }
  .sh__title {
    max-width: 18ch;
    font-size: var(--t-h2);
    font-weight: var(--w-bold);
    line-height: 1;
    letter-spacing: var(--ls-display);
  }
  .sh__lead {
    max-width: 52ch;
    font-size: var(--t-lg);
    color: var(--c-ink-soft);
  }
  :global(.on-dark) .sh__lead { color: var(--c-on-dark-soft); }
</style>
