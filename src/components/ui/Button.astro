---
import Icon from './Icon.astro';

interface Props {
  href: string;
  variant?: 'primary' | 'ghost' | 'dark' | 'light';
  size?: 'md' | 'lg';
  icon?: 'arrow' | 'whatsapp' | 'mail' | 'arrow-down';
  external?: boolean;
  class?: string;
  [key: `data-${string}`]: string | undefined;
  'aria-label'?: string;
}

const { href, variant = 'primary', size = 'md', icon = 'arrow', external = false, class: className, ...rest } = Astro.props;
const ext = external ? { target: '_blank', rel: 'noopener' } : {};
// O texto aparece duas vezes: no hover a cópia de baixo sobe no lugar da de cima
const label = await Astro.slots.render('default');
---

<a href={href} class:list={['btn', `btn--${variant}`, `btn--${size}`, { 'btn--still': icon !== 'arrow' }, className]} {...ext} {...rest}>
  <span class="btn__label">
    <span class="btn__text" set:html={label} />
    <span class="btn__text btn__text--next" aria-hidden="true" set:html={label} />
  </span>
  <span class="btn__icon"><Icon name={icon} size={18} /></span>
</a>

<style>
  .btn {
    --h: 48px;
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 12px;
    min-height: var(--h);
    padding: 6px 6px 6px 22px;
    border-radius: var(--r-pill);
    font-size: var(--t-sm);
    font-weight: 700;
    letter-spacing: -0.005em;
    line-height: 1.1;
    white-space: nowrap;
    isolation: isolate;
    overflow: hidden;
    transition:
      transform var(--d-med) var(--ease-spring),
      background-color var(--d-fast) ease,
      color var(--d-fast) ease,
      box-shadow var(--d-med) var(--ease-out);
  }
  .btn--lg { --h: 58px; font-size: var(--t-md); padding-left: 26px; }

  /* Texto que rola para cima no hover */
  .btn__label {
    position: relative;
    display: grid;
    overflow: hidden;
    padding-block: 0.15em;
  }
  .btn__text {
    grid-area: 1 / 1;
    transition: transform 0.55s var(--ease-out);
  }
  .btn__text--next { transform: translateY(115%); }

  /* Faixa de brilho que atravessa o botão no hover */
  .btn::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(105deg, transparent 35%, rgb(255 255 255 / 0.45) 50%, transparent 65%);
    transform: translateX(-110%);
    pointer-events: none;
  }

  .btn__icon {
    display: grid;
    place-items: center;
    width: calc(var(--h) - 12px);
    aspect-ratio: 1;
    border-radius: 50%;
    transition: transform var(--d-med) var(--ease-spring), background-color var(--d-fast) ease;
  }
  .btn:hover { transform: translateY(-2px); }
  @media (hover: hover) {
    .btn:hover .btn__text { transform: translateY(-115%); }
    .btn:hover .btn__text--next { transform: none; }
    .btn:hover::after { transform: translateX(110%); transition: transform 0.9s var(--ease-out); }
  }
  .btn--dark::after, .btn--light::after { opacity: 0.4; }
  .btn:focus-visible .btn__text { transform: translateY(-115%); }
  .btn:focus-visible .btn__text--next { transform: none; }
  .btn:hover .btn__icon { transform: rotate(-45deg); }
  .btn:active { transform: translateY(0) scale(0.98); }
  .btn--still:hover .btn__icon { transform: scale(1.08); }

  /* Verde: o CTA principal */
  .btn--primary { background: var(--c-green); color: var(--c-ink); box-shadow: 0 8px 24px -10px var(--c-green-glow); }
  .btn--primary .btn__icon { background: var(--c-ink); color: var(--c-green); }
  .btn--primary:hover { background: var(--c-green-hover); box-shadow: 0 14px 34px -10px var(--c-green-glow); }

  .btn--dark { background: var(--c-ink); color: var(--c-on-dark); }
  .btn--dark .btn__icon { background: var(--c-on-dark); color: var(--c-ink); }

  .btn--ghost { background: transparent; color: var(--c-ink); box-shadow: inset 0 0 0 1.5px var(--c-line); }
  .btn--ghost .btn__icon { background: var(--c-surface-2); }
  .btn--ghost:hover { box-shadow: inset 0 0 0 1.5px var(--c-ink); }

  .btn--light { background: transparent; color: var(--c-on-dark); box-shadow: inset 0 0 0 1.5px var(--c-dark-line); }
  .btn--light .btn__icon { background: var(--c-dark-2); }
  .btn--light:hover { box-shadow: inset 0 0 0 1.5px var(--c-on-dark); }
</style>
