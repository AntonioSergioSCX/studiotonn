---
/**
 * Como funciona: quatro passos lado a lado, cada um com um ícone num círculo branco,
 * ligados por uma linha fina. No celular viram uma lista com a linha descendo.
 */
import SectionHead from './ui/SectionHead.astro';
import Button from './ui/Button.astro';
import { process, whatsappLink } from '../content/site';

const svgs = import.meta.glob('../icons/passo-*.svg', { query: '?raw', import: 'default', eager: true }) as Record<string, string>;
const icon = (name: string) => svgs[`../icons/${name}.svg`] ?? '';
---

<section class="section process" id="processo" aria-labelledby="processo-title">
  <div class="container">
    <SectionHead eyebrow={process.eyebrow} title={process.title} lead={process.lead} id="processo-title" />

    <ol class="steps" role="list" aria-label="Etapas">
      {process.steps.map((step, i) => (
        <li class="step" data-reveal style={`--i:${i}`}>
          <span class="step__icon" aria-hidden="true" set:html={icon(step.icon)} />
          <div class="step__body">
            <h3 class="step__title"><span class="sr-only">Passo {i + 1}: </span>{step.title}</h3>
            <p class="step__text">{step.text}</p>
          </div>
        </li>
      ))}
    </ol>

    <div class="process__cta" data-reveal>
      <Button href={whatsappLink(process.ctaMessage)} icon="whatsapp" external>{process.cta}</Button>
    </div>
  </div>
</section>

<style>
  .process { padding-top: 0; }
  .process :global(.sh__title) { font-weight: var(--w-medium); }

  .steps { --dot: 64px; display: grid; gap: 28px; }
  .step { position: relative; display: grid; grid-template-columns: var(--dot) 1fr; gap: 18px; align-items: start; }

  /* Ícone num círculo branco com sombra suave */
  .step__icon {
    position: relative;
    z-index: 1;
    display: grid;
    place-items: center;
    width: var(--dot);
    height: var(--dot);
    border-radius: 50%;
    background: var(--c-surface);
    box-shadow: 0 10px 24px -10px rgb(13 15 13 / 0.22), 0 0 0 1px rgb(13 15 13 / 0.04);
    color: #51b338;
  }
  .step__icon :global(svg) { width: 26px; height: 26px; }

  /* Linha entre os passos: desce no celular, corre de lado no computador */
  .step:not(:last-child)::after {
    content: '';
    position: absolute;
    left: calc(var(--dot) / 2 - 1px);
    top: calc(var(--dot) + 8px);
    bottom: -20px;
    width: 2px;
    border-radius: 2px;
    background: linear-gradient(180deg, rgb(13 15 13 / 0.12), rgb(13 15 13 / 0.04));
  }

  .step__body { padding-top: 6px; }
  .step__title { font-size: 1.25rem; font-weight: var(--w-medium); letter-spacing: var(--ls-title); line-height: 1.25; }
  .step__text { margin-top: 8px; font-size: var(--t-md); line-height: 1.55; color: var(--c-ink-soft); }

  @media (min-width: 900px) {
    .steps { grid-template-columns: repeat(4, 1fr); gap: 24px; }
    .step { grid-template-columns: 1fr; justify-items: center; gap: 24px; text-align: center; }
    .step:not(:last-child)::after {
      left: calc(50% + var(--dot) / 2 + 28px);
      right: calc(-50% + var(--dot) / 2 + 28px - 24px);
      top: calc(var(--dot) / 2 - 1px);
      bottom: auto;
      width: auto;
      height: 2px;
      background: linear-gradient(90deg, rgb(13 15 13 / 0.04), rgb(13 15 13 / 0.14) 50%, rgb(13 15 13 / 0.04));
    }
    .step__body { padding-top: 0; }
    .step__text { max-width: 30ch; margin-inline: auto; }
  }

  .process__cta { display: flex; justify-content: center; margin-top: clamp(40px, 5vw, 64px); }
</style>
