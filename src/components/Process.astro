---
/**
 * Como funciona: bloco escuro com uma textura de pontos que ondula devagar (WebGL)
 * e uma linha do tempo: a linha verde corre e vai acendendo cada passo.
 */
import Words from './ui/Words.astro';
import { process } from '../content/site';

const total = process.steps.length;
---

<section class="section process" id="processo" aria-labelledby="processo-title">
  <div class="container">
    <div class="process__panel on-dark">
      <canvas class="process__bg" aria-hidden="true" data-halftone></canvas>

      <header class="process__head">
        <p class="process__eyebrow" data-reveal><span aria-hidden="true"></span>{process.eyebrow}</p>
        <h2 class="process__title split split--scroll" id="processo-title" data-split>
          <Words text={process.title} />
        </h2>
        <p class="process__lead" data-reveal style="--i:2">{process.lead}</p>
      </header>

      <div class="timeline" data-reveal style={`--n:${total}`}>
        <span class="timeline__line" aria-hidden="true"><span></span></span>
        <ol class="steps" role="list" aria-label="Etapas">
          {process.steps.map((step, i) => (
            <li class="step" style={`--i:${i}`}>
              <span class="step__node" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
              <div class="step__card">
                <img class="step__icon" src={step.icon} srcset={`${step.icon} 1x, ${step.icon.replace('.webp', '@2x.webp')} 2x`} alt="" width="112" height="112" loading="lazy" decoding="async" />
                <h3 class="step__title"><span class="sr-only">Passo {i + 1}: </span>{step.title}</h3>
                <p class="step__text">{step.text}</p>
                {step.badge && <p class="step__badge">{step.badge}</p>}
              </div>
            </li>
          ))}
        </ol>
      </div>
    </div>
  </div>
</section>

<script>
  /* Meio-tom: uma grade de pontos cujo tamanho segue faixas diagonais que ondulam devagar.
     Só anima com o bloco na tela; com "reduzir movimento" desenha um quadro parado. */
  const canvas = document.querySelector<HTMLCanvasElement>('[data-halftone]');
  const gl = canvas?.getContext('webgl', { antialias: false, alpha: false, powerPreference: 'low-power' });

  if (canvas && gl) {
    const vert = `attribute vec2 p; void main() { gl_Position = vec4(p, 0.0, 1.0); }`;
    const frag = `
      precision mediump float;
      uniform vec2 res;
      uniform float t;
      uniform float cell;
      float field(vec2 q) {
        float s = q.x * 0.6 + q.y * 0.8;
        float warp = sin(q.y * 2.2 + t * 0.21) * 0.9 + sin(q.x * 1.5 - t * 0.13) * 0.6;
        float w = sin(s * 10.0 - t * 0.35 + warp);
        float w2 = sin(s * 3.1 + t * 0.09 - q.x * 1.7);
        return clamp(pow(0.5 + 0.5 * w, 2.2) * (0.35 + 0.65 * (0.5 + 0.5 * w2)), 0.0, 1.0);
      }
      void main() {
        vec2 px = gl_FragCoord.xy;
        vec2 c = (floor(px / cell) + 0.5) * cell;
        float f = field(c / res.y);
        float r = cell * 0.5 * (0.25 + 0.75 * f);
        float dot = smoothstep(r, r - 1.0, length(px - c));
        vec3 bg = vec3(0.051, 0.059, 0.051);
        vec3 ink = mix(vec3(0.78, 0.8, 0.78), vec3(0.37, 0.8, 0.26), 0.1);
        gl_FragColor = vec4(mix(bg, ink, dot * (0.05 + 0.45 * f)), 1.0);
      }`;
    const shader = (type: number, src: string) => {
      const s = gl.createShader(type)!;
      gl.shaderSource(s, src);
      gl.compileShader(s);
      return s;
    };
    const prog = gl.createProgram()!;
    gl.attachShader(prog, shader(gl.VERTEX_SHADER, vert));
    gl.attachShader(prog, shader(gl.FRAGMENT_SHADER, frag));
    gl.linkProgram(prog);
    gl.useProgram(prog);

    gl.bindBuffer(gl.ARRAY_BUFFER, gl.createBuffer());
    gl.bufferData(gl.ARRAY_BUFFER, new Float32Array([-1, -1, 3, -1, -1, 3]), gl.STATIC_DRAW);
    const loc = gl.getAttribLocation(prog, 'p');
    gl.enableVertexAttribArray(loc);
    gl.vertexAttribPointer(loc, 2, gl.FLOAT, false, 0, 0);
    const uRes = gl.getUniformLocation(prog, 'res');
    const uT = gl.getUniformLocation(prog, 't');
    const uCell = gl.getUniformLocation(prog, 'cell');

    const still = matchMedia('(prefers-reduced-motion: reduce)');
    let dpr = 1;
    let raf = 0;
    let visible = false;
    let t = 8;
    let last = 0;

    const draw = () => {
      gl.uniform1f(uT, t);
      gl.drawArrays(gl.TRIANGLES, 0, 3);
    };
    const resize = () => {
      dpr = Math.min(window.devicePixelRatio || 1, 1.5);
      canvas.width = Math.round(canvas.clientWidth * dpr);
      canvas.height = Math.round(canvas.clientHeight * dpr);
      gl.viewport(0, 0, canvas.width, canvas.height);
      gl.uniform2f(uRes, canvas.width, canvas.height);
      gl.uniform1f(uCell, 4 * dpr);
      draw();
    };
    const loop = (now: number) => {
      if (last) t += Math.min(now - last, 50) / 1000;
      last = now;
      draw();
      raf = requestAnimationFrame(loop);
    };
    const sync = () => {
      cancelAnimationFrame(raf);
      last = 0;
      if (visible && !still.matches && !document.hidden) raf = requestAnimationFrame(loop);
    };

    new ResizeObserver(resize).observe(canvas);
    new IntersectionObserver(([e]) => { visible = e.isIntersecting; sync(); }).observe(canvas);
    document.addEventListener('visibilitychange', sync);
    still.addEventListener('change', sync);
    canvas.classList.add('is-on');
  }
</script>

<style>
  .process { padding-top: 0; }

  .process__panel {
    position: relative;
    padding: clamp(28px, 5vw, 64px) clamp(20px, 4vw, 56px) clamp(40px, 5vw, 64px);
    border-radius: var(--r-xl);
    background: var(--c-dark);
    color: var(--c-on-dark);
    overflow: hidden;
    isolation: isolate;
  }
  /* Sem WebGL fica o fundo escuro com uma luz suave */
  .process__bg {
    position: absolute;
    inset: 0;
    z-index: -1;
    width: 100%;
    height: 100%;
    opacity: 0;
    transition: opacity 1.2s ease;
  }
  .process__bg:global(.is-on) { opacity: 1; }
  .process__panel::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -2;
    background: radial-gradient(60% 50% at 70% 30%, rgb(94 204 66 / 0.08), transparent 70%);
  }

  .process__head {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 18px;
    margin-bottom: clamp(48px, 7vw, 88px);
    text-align: center;
  }
  .process__eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 6px 12px;
    border-radius: var(--r-pill);
    background: rgb(245 244 239 / 0.06);
    box-shadow: inset 0 0 0 1px var(--c-dark-line);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    font-family: var(--f-mono);
    font-size: 0.75rem;
    font-weight: var(--w-medium);
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--c-on-dark-soft);
  }
  .process__eyebrow span {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--c-green);
    box-shadow: 0 0 0 3px rgb(94 204 66 / 0.2);
  }
  .process__title {
    max-width: 16ch;
    font-size: var(--t-h2);
    font-weight: var(--w-bold);
    line-height: 1;
    letter-spacing: var(--ls-display);
    text-wrap: balance;
  }
  .process__lead { max-width: 46ch; font-size: var(--t-lg); color: var(--c-on-dark-soft); }

  /* Linha do tempo: no computador corre na horizontal, no celular desce pela esquerda */
  .timeline { --node: 40px; position: relative; }
  .timeline__line {
    position: absolute;
    left: calc(var(--node) / 2 - 1px);
    top: calc(var(--node) / 2);
    bottom: 40px;
    width: 2px;
    border-radius: 2px;
    background: rgb(245 244 239 / 0.12);
    overflow: hidden;
  }
  .timeline__line span {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, var(--c-green), #b6f23a);
    transform-origin: top;
  }
  .steps { display: grid; gap: 20px; }
  .step {
    position: relative;
    display: grid;
    grid-template-columns: var(--node) 1fr;
    gap: 16px;
    align-items: start;
  }
  .step__node {
    position: relative;
    z-index: 1;
    display: grid;
    place-items: center;
    width: var(--node);
    height: var(--node);
    border-radius: 50%;
    background: var(--c-green);
    color: var(--c-ink);
    box-shadow: 0 0 0 6px rgb(94 204 66 / 0.16), 0 0 24px rgb(94 204 66 / 0.45);
    font-family: var(--f-mono);
    font-size: 0.75rem;
    font-weight: var(--w-medium);
    letter-spacing: 0;
    transition: background-color 0.5s ease, color 0.5s ease, box-shadow 0.5s ease;
  }

  /* Cartão de vidro sobre a textura */
  .step__card {
    display: flex;
    flex-direction: column;
    height: 100%;
    padding: 22px 22px 24px;
    border-radius: var(--r-lg);
    background: linear-gradient(180deg, rgb(245 244 239 / 0.07), rgb(245 244 239 / 0.03));
    box-shadow: inset 0 0 0 1px var(--c-dark-line), inset 0 1px 0 rgb(245 244 239 / 0.08);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    transition: transform var(--d-slow) var(--ease-out), box-shadow var(--d-slow) var(--ease-out);
  }
  .step__icon {
    width: 72px;
    height: 72px;
    margin: -6px 0 14px -6px;
    filter: drop-shadow(0 12px 16px rgb(0 0 0 / 0.4));
    transition: transform var(--d-slow) var(--ease-spring);
  }
  @media (hover: hover) {
    .step:hover .step__card { transform: translateY(-4px); box-shadow: inset 0 0 0 1px rgb(94 204 66 / 0.35), inset 0 1px 0 rgb(245 244 239 / 0.1); }
    .step:hover .step__icon { transform: translateY(-4px) rotate(-4deg) scale(1.05); }
  }
  .step__title {
    font-size: 1.25rem;
    font-weight: var(--w-bold);
    letter-spacing: var(--ls-title);
    line-height: 1.2;
  }
  .step__text { margin-top: 10px; font-size: var(--t-sm); line-height: 1.5; color: var(--c-on-dark-soft); }
  .step__badge {
    align-self: flex-start;
    margin-top: 16px;
    padding: 5px 12px;
    border-radius: var(--r-pill);
    background: rgb(94 204 66 / 0.14);
    box-shadow: inset 0 0 0 1px rgb(94 204 66 / 0.35);
    color: var(--c-green);
    font-size: var(--t-xs);
    font-weight: var(--w-bold);
  }

  @media (min-width: 1000px) {
    .timeline__line {
      top: calc(var(--node) / 2 - 1px);
      left: calc(var(--node) / 2);
      right: 0;
      bottom: auto;
      width: auto;
      height: 2px;
      mask-image: linear-gradient(90deg, #000 85%, transparent);
      -webkit-mask-image: linear-gradient(90deg, #000 85%, transparent);
    }
    .timeline__line span { background: linear-gradient(90deg, var(--c-green), #b6f23a); transform-origin: left; }
    .steps { grid-template-columns: repeat(var(--n), 1fr); gap: 16px; }
    .step { grid-template-columns: 1fr; grid-template-rows: var(--node) 1fr; gap: 20px; }
  }

  /* A linha corre do primeiro ao último passo; cada bolinha acende quando a linha chega nela */
  @media (prefers-reduced-motion: no-preference) {
    :global(.js) .timeline__line span { transform: scaleY(0); transition: transform 1.8s linear 0.3s; }
    :global(.js) .timeline:global(.is-in) .timeline__line span { transform: none; }
    :global(.js) .step__node {
      background: var(--c-dark-2);
      color: var(--c-on-dark-soft);
      box-shadow: inset 0 0 0 1px rgb(245 244 239 / 0.18);
      transition-delay: calc(0.3s + var(--i) * 0.45s);
    }
    :global(.js) .timeline:global(.is-in) .step__node {
      background: var(--c-green);
      color: var(--c-ink);
      box-shadow: 0 0 0 6px rgb(94 204 66 / 0.16), 0 0 24px rgb(94 204 66 / 0.45);
    }
    :global(.js) .step__card {
      opacity: 0;
      transform: translateY(16px);
      transition: opacity 0.7s ease calc(0.35s + var(--i) * 0.45s), transform 0.8s var(--ease-out) calc(0.35s + var(--i) * 0.45s);
    }
    :global(.js) .timeline:global(.is-in) .step__card { opacity: 1; transform: none; }
    @media (min-width: 1000px) {
      :global(.js) .timeline__line span { transform: scaleX(0); }
    }
  }
</style>
