---
import SectionHead from './ui/SectionHead.astro';
import { process } from '../content/site';
---

<section class="section process" id="processo" aria-labelledby="processo-title">
  <div class="container">
    <SectionHead index="002" eyebrow={process.eyebrow} title={process.title} id="processo-title" />

    <ol class="steps snap-mobile" role="list" aria-label="Etapas">
      {process.steps.map((step, i) => (
        <li class="step" data-reveal style={`--i:${i}`}>
          <span class="step__num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
          <img class="step__icon" src={step.icon} srcset={`${step.icon} 1x, ${step.icon.replace('.webp', '@2x.webp')} 2x`} alt="" width="112" height="112" loading="lazy" decoding="async" />
          <h3 class="step__title"><span class="sr-only">Passo {i + 1}: </span>{step.title}</h3>
          <p class="step__text">{step.text}</p>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .process { padding-top: 0; }
  .steps { display: grid; gap: 16px; }
  @media (min-width: 760px) { .steps { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 1100px) { .steps { grid-template-columns: repeat(4, 1fr); } }

  .step {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 36px 24px 32px;
    border-radius: var(--r-lg);
    background: var(--c-surface);
    box-shadow: inset 0 0 0 1px var(--c-line);
    text-align: center;
    transition: transform var(--d-slow) var(--ease-out), box-shadow var(--d-slow) var(--ease-out);
  }
  .step:hover { transform: translateY(-4px); box-shadow: inset 0 0 0 1px var(--c-line), var(--shadow-2); }

  .step__num {
    position: absolute;
    top: 18px;
    left: 20px;
    font-family: var(--f-mono);
    font-size: 0.75rem;
    font-weight: var(--w-medium);
    letter-spacing: 0;
    color: var(--c-green-ink);
  }
  .step__icon {
    width: 112px;
    height: 112px;
    margin-bottom: 24px;
    filter: drop-shadow(0 14px 18px rgb(13 15 13 / 0.12));
    transition: transform var(--d-slow) var(--ease-spring);
  }
  .step:hover .step__icon { transform: translateY(-6px) rotate(-3deg) scale(1.04); }
  .step__title {
    font-size: 1.25rem;
    font-weight: var(--w-bold);
    letter-spacing: var(--ls-title);
    line-height: 1.2;
  }
  .step__text { margin-top: 10px; max-width: 30ch; color: var(--c-ink-soft); font-size: var(--t-sm); }
</style>
