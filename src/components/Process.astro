---
/**
 * Como funciona: bloco escuro com uma textura de pontos que ondula devagar (WebGL),
 * passos em colunas que descem em escada e uma barra mostrando o quanto do caminho já foi feito.
 */
import Words from './ui/Words.astro';
import { process } from '../content/site';

const total = process.steps.length;
---

<section class="section process" id="processo" aria-labelledby="processo-title">
  <div class="container">
    <div class="process__panel on-dark">
      <canvas class="process__bg" aria-hidden="true" data-halftone></canvas>

      <header class="process__head">
        <div>
          <p class="process__eyebrow" data-reveal>
            <span class="process__dots" aria-hidden="true"><i></i><i></i><i></i><i></i><i></i></span>
            {process.eyebrow}
          </p>
          <h2 class="process__title split split--scroll" id="processo-title" data-split>
            <Words text={process.title} />
          </h2>
        </div>
        <p class="process__lead" data-reveal style="--i:2">{process.lead}</p>
      </header>

      <ol class="steps" role="list" aria-label="Etapas">
        {process.steps.map((step, i) => {
          const pct = Math.round(((i + 1) / total) * 100);
          return (
            <li class="step" data-reveal style={`--i:${i};--p:${pct / 100}`}>
              <div class="step__body">
                <span class="step__num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
                <h3 class="step__title"><span class="sr-only">Passo {i + 1}: </span>{step.title}</h3>
                <p class="step__text">{step.text}</p>
                {step.badge && <p class="step__badge">{step.badge}</p>}
                <div class="step__progress" aria-hidden="true">
                  <span class="step__pct">{pct}%</span>
                  <span class="step__bar"><span></span></span>
                </div>
              </div>
            </li>
          );
        })}
      </ol>
    </div>
  </div>
</section>

<script>
  /* Meio-tom: uma grade de pontos cujo tamanho segue faixas diagonais que ondulam devagar.
     Só anima com o bloco na tela; com "reduzir movimento" desenha um quadro parado. */
  const canvas = document.querySelector<HTMLCanvasElement>('[data-halftone]');
  const gl = canvas?.getContext('webgl', { antialias: false, alpha: false, powerPreference: 'low-power' });

  if (canvas && gl) {
    const vert = `attribute vec2 p; void main() { gl_Position = vec4(p, 0.0, 1.0); }`;
    const frag = `
      precision mediump float;
      uniform vec2 res;
      uniform float t;
      uniform float cell;
      float field(vec2 q) {
        float s = q.x * 0.6 + q.y * 0.8;
        float warp = sin(q.y * 2.2 + t * 0.21) * 0.9 + sin(q.x * 1.5 - t * 0.13) * 0.6;
        float w = sin(s * 10.0 - t * 0.35 + warp);
        float w2 = sin(s * 3.1 + t * 0.09 - q.x * 1.7);
        return clamp(pow(0.5 + 0.5 * w, 2.2) * (0.35 + 0.65 * (0.5 + 0.5 * w2)), 0.0, 1.0);
      }
      void main() {
        vec2 px = gl_FragCoord.xy;
        vec2 c = (floor(px / cell) + 0.5) * cell;
        float f = field(c / res.y);
        float r = cell * 0.5 * (0.25 + 0.75 * f);
        float dot = smoothstep(r, r - 1.0, length(px - c));
        vec3 bg = vec3(0.051, 0.059, 0.051);
        vec3 ink = mix(vec3(0.78, 0.8, 0.78), vec3(0.37, 0.8, 0.26), 0.1);
        gl_FragColor = vec4(mix(bg, ink, dot * (0.05 + 0.45 * f)), 1.0);
      }`;
    const shader = (type: number, src: string) => {
      const s = gl.createShader(type)!;
      gl.shaderSource(s, src);
      gl.compileShader(s);
      return s;
    };
    const prog = gl.createProgram()!;
    gl.attachShader(prog, shader(gl.VERTEX_SHADER, vert));
    gl.attachShader(prog, shader(gl.FRAGMENT_SHADER, frag));
    gl.linkProgram(prog);
    gl.useProgram(prog);

    gl.bindBuffer(gl.ARRAY_BUFFER, gl.createBuffer());
    gl.bufferData(gl.ARRAY_BUFFER, new Float32Array([-1, -1, 3, -1, -1, 3]), gl.STATIC_DRAW);
    const loc = gl.getAttribLocation(prog, 'p');
    gl.enableVertexAttribArray(loc);
    gl.vertexAttribPointer(loc, 2, gl.FLOAT, false, 0, 0);
    const uRes = gl.getUniformLocation(prog, 'res');
    const uT = gl.getUniformLocation(prog, 't');
    const uCell = gl.getUniformLocation(prog, 'cell');

    const still = matchMedia('(prefers-reduced-motion: reduce)');
    let dpr = 1;
    let raf = 0;
    let visible = false;
    let t = 8;
    let last = 0;

    const draw = () => {
      gl.uniform1f(uT, t);
      gl.drawArrays(gl.TRIANGLES, 0, 3);
    };
    const resize = () => {
      dpr = Math.min(window.devicePixelRatio || 1, 1.5);
      canvas.width = Math.round(canvas.clientWidth * dpr);
      canvas.height = Math.round(canvas.clientHeight * dpr);
      gl.viewport(0, 0, canvas.width, canvas.height);
      gl.uniform2f(uRes, canvas.width, canvas.height);
      gl.uniform1f(uCell, 4 * dpr);
      draw();
    };
    const loop = (now: number) => {
      if (last) t += Math.min(now - last, 50) / 1000;
      last = now;
      draw();
      raf = requestAnimationFrame(loop);
    };
    const sync = () => {
      cancelAnimationFrame(raf);
      last = 0;
      if (visible && !still.matches && !document.hidden) raf = requestAnimationFrame(loop);
    };

    new ResizeObserver(resize).observe(canvas);
    new IntersectionObserver(([e]) => { visible = e.isIntersecting; sync(); }).observe(canvas);
    document.addEventListener('visibilitychange', sync);
    still.addEventListener('change', sync);
    canvas.classList.add('is-on');
  }
</script>

<style>
  .process { padding-top: 0; }

  .process__panel {
    position: relative;
    padding: clamp(28px, 5vw, 64px) clamp(20px, 4vw, 56px) clamp(40px, 5vw, 64px);
    border-radius: var(--r-xl);
    background: var(--c-dark);
    color: var(--c-on-dark);
    overflow: hidden;
    isolation: isolate;
  }
  /* Sem WebGL fica o fundo escuro com uma luz suave */
  .process__bg {
    position: absolute;
    inset: 0;
    z-index: -1;
    width: 100%;
    height: 100%;
    opacity: 0;
    transition: opacity 1.2s ease;
  }
  .process__bg:global(.is-on) { opacity: 1; }
  .process__panel::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -2;
    background: radial-gradient(60% 50% at 70% 30%, rgb(94 204 66 / 0.08), transparent 70%);
  }

  .process__head {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    justify-content: space-between;
    gap: 24px 48px;
    margin-bottom: clamp(48px, 8vw, 104px);
  }
  .process__eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-family: var(--f-mono);
    font-size: 0.75rem;
    font-weight: var(--w-medium);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--c-on-dark);
  }
  .process__dots { display: grid; grid-template-columns: repeat(2, 3px); gap: 2px; }
  .process__dots i { width: 3px; height: 3px; border-radius: 50%; background: var(--c-green); }
  .process__dots i:nth-child(2) { grid-column: 1; }
  .process__title {
    max-width: 14ch;
    margin-top: 18px;
    font-size: var(--t-h2);
    font-weight: var(--w-bold);
    line-height: 1;
    letter-spacing: var(--ls-display);
    text-wrap: balance;
  }
  /* Texto à direita com um cantinho marcando o canto, como uma etiqueta */
  .process__lead {
    position: relative;
    max-width: 34ch;
    padding: 14px 18px 0 0;
    font-size: var(--t-sm);
    line-height: 1.5;
    color: var(--c-on-dark-soft);
    text-align: right;
  }
  .process__lead::before {
    content: '';
    position: absolute;
    top: 0;
    right: 0;
    width: 10px;
    height: 10px;
    border-top: 1px solid var(--c-on-dark-soft);
    border-right: 1px solid var(--c-on-dark-soft);
  }
  @media (max-width: 759px) {
    .process__lead { text-align: left; padding: 0; }
    .process__lead::before { display: none; }
  }

  /* Passos: colunas separadas por linhas finas, cada uma começando um pouco mais abaixo */
  .steps { display: grid; }
  .step { position: relative; }
  .step__body {
    display: flex;
    flex-direction: column;
    padding: 28px 0;
  }
  .step + .step { border-top: 1px solid var(--c-dark-line); }
  @media (min-width: 760px) {
    .steps { grid-template-columns: repeat(2, 1fr); }
    .step { padding-inline: clamp(16px, 2vw, 28px); }
    .step + .step { border-top: 0; }
    .step:nth-child(even) { border-left: 1px solid var(--c-dark-line); }
    .step:nth-child(even) .step__body { padding-top: 72px; }
    .step:nth-child(n + 3) { border-top: 1px solid var(--c-dark-line); }
  }
  @media (min-width: 1100px) {
    .steps { grid-template-columns: repeat(4, 1fr); }
    .step:first-child { padding-left: 0; }
    .step:last-child { padding-right: 0; }
    .step + .step,
    .step:nth-child(n + 3) { border-top: 0; border-left: 1px solid var(--c-dark-line); }
    .step .step__body,
    .step:nth-child(even) .step__body { padding-top: calc(var(--i) * clamp(56px, 6vw, 96px)); padding-bottom: 0; }
  }

  .step__num {
    font-family: var(--f-mono);
    font-size: 0.75rem;
    font-weight: var(--w-medium);
    letter-spacing: 0;
    color: var(--c-green);
  }
  .step__title {
    margin-top: 10px;
    font-size: 1.375rem;
    font-weight: var(--w-bold);
    letter-spacing: var(--ls-title);
    line-height: 1.15;
  }
  .step__text { margin-top: 12px; max-width: 32ch; font-size: var(--t-sm); line-height: 1.5; color: var(--c-on-dark-soft); }
  .step__badge {
    align-self: flex-start;
    margin-top: 16px;
    padding: 5px 12px;
    border-radius: var(--r-pill);
    background: rgb(94 204 66 / 0.14);
    box-shadow: inset 0 0 0 1px rgb(94 204 66 / 0.35);
    color: var(--c-green);
    font-size: var(--t-xs);
    font-weight: var(--w-bold);
  }

  /* Barra: enche até a porcentagem do passo quando a coluna aparece */
  .step__progress { margin-top: 28px; }
  .step__pct { font-family: var(--f-mono); font-size: 0.75rem; color: var(--c-on-dark-soft); }
  .step__bar {
    display: block;
    height: 4px;
    margin-top: 8px;
    border-radius: 4px;
    background: rgb(245 244 239 / 0.14);
    overflow: hidden;
  }
  .step__bar span {
    display: block;
    height: 100%;
    border-radius: inherit;
    background: linear-gradient(90deg, var(--c-green), #b6f23a);
    transform: scaleX(var(--p));
    transform-origin: left;
  }
  @media (prefers-reduced-motion: no-preference) {
    :global(.js) .step__bar span {
      transform: scaleX(0);
      transition: transform 1.4s var(--ease-out) calc(300ms + var(--i) * 140ms);
    }
    :global(.js) .step:global(.is-in) .step__bar span { transform: scaleX(var(--p)); }
  }
</style>
