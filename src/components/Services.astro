---
/**
 * Serviços: três cards. O Site em destaque é branco com um degradê verde-menta no topo;
 * os outros ficam no cinza dos cards. Botão escuro de largura total com o ícone do WhatsApp.
 */
import SectionHead from './ui/SectionHead.astro';
import Icon from './ui/Icon.astro';
import { services, site, whatsappLink, brl } from '../content/site';
---

<section class="section services" id="servicos" aria-labelledby="servicos-title">
  <div class="container">
    <SectionHead eyebrow={services.eyebrow} title={services.title} lead={services.lead} id="servicos-title" />

    <ul class="plans snap-mobile" role="list" aria-label="Serviços">
      {services.items.map((item, i) => (
        <li class:list={['plan', { 'plan--featured': item.featured }]} data-reveal style={`--i:${i}`}>
          <h3 class="plan__name">{item.name}</h3>
          {services.showPrices && (
            <>
              <p class="plan__price">
                <span class="plan__from">{services.pricePrefix}</span>
                <strong>{brl(item.price)}</strong>
              </p>
              <p class="plan__note">{item.priceNote}</p>
            </>
          )}
          <p class="plan__desc">{item.desc}</p>
          <p class="plan__time"><Icon name="clock" size={20} />{item.time}</p>
          <ul class="plan__features" role="list">
            {item.features.map((f) => (
              <li><Icon name="check" size={18} />{f}</li>
            ))}
          </ul>
          <a
            class="plan__cta"
            href={whatsappLink(`Oi, ${site.owner}! Vim pelo site e quero um orçamento de ${item.name.toLowerCase()}.`)}
            target="_blank"
            rel="noopener"
            aria-label={`${services.cta} de ${item.name.toLowerCase()} pelo WhatsApp`}
          >
            {services.cta}<Icon name="whatsapp" size={22} />
          </a>
        </li>
      ))}
    </ul>

    <ul class="guarantees" role="list">
      {services.guarantees.map((g, i) => (
        <li data-reveal style={`--i:${i}`}>
          <img class="guarantees__icon" src={g.icon} srcset={`${g.icon} 1x, ${g.icon.replace('.webp', '@2x.webp')} 2x`} alt="" width="64" height="64" loading="lazy" decoding="async" />
          <strong>{g.title}</strong>
          <span>{g.text}</span>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .services :global(.sh__title) { max-width: 22ch; font-weight: var(--w-medium); }

  .plans { display: grid; gap: 20px; align-items: stretch; }
  @media (min-width: 900px) { .plans { grid-template-columns: repeat(3, 1fr); gap: 24px; } }

  .plan {
    position: relative;
    display: flex;
    flex-direction: column;
    padding: clamp(24px, 2.4vw, 32px);
    border-radius: 20px;
    background: #ecebe7;
    isolation: isolate;
    overflow: hidden;
  }
  /* Destaque: card branco, degradê verde-menta descendo do topo e sombra */
  .plan--featured {
    background: var(--c-surface);
    box-shadow: 0 30px 60px -30px rgb(13 15 13 / 0.3), 0 0 0 1px rgb(13 15 13 / 0.04);
  }
  .plan--featured::before {
    content: '';
    position: absolute;
    inset: 0 0 auto;
    z-index: -1;
    height: 46%;
    background:
      radial-gradient(70% 90% at 15% 0%, rgb(170 240 215 / 0.75), transparent 70%),
      radial-gradient(60% 80% at 90% 10%, rgb(200 240 170 / 0.8), transparent 70%);
    mask-image: linear-gradient(180deg, #000 40%, transparent);
    -webkit-mask-image: linear-gradient(180deg, #000 40%, transparent);
  }

  .plan__name {
    font-size: clamp(2rem, 1.5rem + 1.4vw, 2.75rem);
    font-weight: var(--w-medium);
    line-height: 1.05;
    letter-spacing: var(--ls-display);
  }
  .plan__price { display: flex; align-items: baseline; flex-wrap: wrap; gap: 4px 10px; margin-top: 16px; }
  .plan__from { font-size: var(--t-xs); color: var(--c-ink-soft); }
  .plan__price strong { font-size: clamp(1.6rem, 1.3rem + 0.8vw, 2rem); font-weight: var(--w-bold); line-height: 1; }
  .plan__note { margin-top: 6px; font-size: var(--t-xs); color: var(--c-ink-soft); }
  .plan__desc { margin-top: 20px; font-size: var(--t-lg); line-height: 1.45; color: var(--c-ink-soft); }
  .plan__time {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    margin-top: 24px;
    font-size: var(--t-md);
    color: var(--c-ink-soft);
  }
  .plan__features {
    display: grid;
    gap: 16px;
    margin-block: 40px 40px;
    font-size: var(--t-md);
    color: var(--c-ink-soft);
  }
  .plan__features li { display: flex; align-items: flex-start; gap: 12px; }
  .plan__features :global(svg) { flex: none; margin-top: 2px; color: #51b338; }

  /* Botão escuro de largura total; o ícone do WhatsApp fica logo depois do texto */
  .plan__cta {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 12px;
    margin-top: auto;
    min-height: 56px;
    padding: 12px 20px;
    border-radius: 12px;
    background: #3d4048;
    color: #fff;
    font-size: 1.125rem;
    font-weight: var(--w-semibold);
    box-shadow: inset 0 -2px 0 rgb(0 0 0 / 0.25);
    transition: background-color var(--d-fast) ease;
  }
  @media (hover: hover) {
    .plan__cta:hover { background: var(--c-ink); }
  }
  .plan__cta:focus-visible { outline: 2px solid var(--c-green); outline-offset: 3px; }

  .guarantees {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 24px 16px;
    /* garantias são um grupo próprio: mais longe dos planos do que os planos entre si */
    margin-top: clamp(40px, 5vw, 64px);
  }
  @media (min-width: 1100px) { .guarantees { grid-template-columns: repeat(4, 1fr); } }
  .guarantees li {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 4px;
    padding: 0 8px;
    font-size: var(--t-sm);
    line-height: 1.45;
    text-align: center;
    color: var(--c-ink-soft);
  }
  .guarantees strong { font-size: 1.0625rem; font-weight: var(--w-bold); letter-spacing: var(--ls-title); color: var(--c-ink); }
  .guarantees__icon {
    width: 64px;
    height: 64px;
    margin-bottom: 14px;
    filter: drop-shadow(0 10px 14px rgb(94 204 66 / 0.25));
    transition: transform var(--d-slow) var(--ease-spring);
  }
  .guarantees li:hover .guarantees__icon { transform: translateY(-4px) rotate(-4deg); }
  @media (max-width: 639px) {
    .guarantees li { padding: 0 4px; font-size: var(--t-xs); }
    .guarantees__icon { width: 52px; height: 52px; }
  }
</style>
