---
import SectionHead from './ui/SectionHead.astro';
import Button from './ui/Button.astro';
import Icon from './ui/Icon.astro';
import { services, site, whatsappLink } from '../content/site';
---

<section class="section services" id="servicos" aria-labelledby="servicos-title">
  <div class="container">
    <SectionHead index="003" eyebrow={services.eyebrow} title={services.title} lead={services.lead} id="servicos-title" />

    <ul class="plans snap-mobile" role="list" aria-label="Serviços">
      {services.items.map((item, i) => (
        <li
          class:list={['plan', { 'plan--featured on-dark': item.featured }]}
          data-reveal
          style={`--i:${i}`}
          data-spotlight={item.featured ? '' : undefined}
        >
          <div class="plan__top">
            <span class="plan__index">{String(i + 1).padStart(2, '0')}</span>
            {item.featured && <span class="plan__badge">{services.featuredBadge}</span>}
          </div>
          <h3 class="plan__name">{item.name}</h3>
          <p class="plan__desc">{item.desc}</p>
          <p class="plan__time"><Icon name="clock" size={15} />{item.time}</p>
          <ul class="plan__features" role="list">
            {item.features.map((f) => (
              <li><Icon name="check" size={16} />{f}</li>
            ))}
          </ul>
          <Button
            href={whatsappLink(`Oi, ${site.owner}! Vim pelo site e quero um orçamento de ${item.name.toLowerCase()}.`)}
            variant={item.featured ? 'primary' : 'dark'}
            icon="whatsapp"
            external
            class="plan__cta"
            aria-label={`${services.cta} de ${item.name.toLowerCase()} pelo WhatsApp`}
          >
            {services.cta}
          </Button>
        </li>
      ))}
    </ul>

    <ul class="guarantees" role="list">
      {services.guarantees.map((g, i) => (
        <li data-reveal style={`--i:${i}`}>
          <img class="guarantees__icon" src={g.icon} srcset={`${g.icon} 1x, ${g.icon.replace('.webp', '@2x.webp')} 2x`} alt="" width="64" height="64" loading="lazy" decoding="async" />
          <strong>{g.title}</strong>
          <span>{g.text}</span>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .plans { display: grid; gap: 16px; align-items: stretch; }
  @media (min-width: 900px) { .plans { grid-template-columns: repeat(3, 1fr); } }

  .plan {
    position: relative;
    display: flex;
    flex-direction: column;
    padding: 28px;
    border-radius: var(--r-lg);
    background: var(--c-surface);
    box-shadow: inset 0 0 0 1px var(--c-line);
    overflow: hidden;
    isolation: isolate;
    transition: transform var(--d-slow) var(--ease-out), box-shadow var(--d-slow) var(--ease-out);
  }
  .plan:not(.plan--featured):hover {
    transform: translateY(-4px);
    box-shadow: inset 0 0 0 1px var(--c-line), var(--shadow-2);
  }
  .plan--featured {
    background: var(--c-dark);
    color: var(--c-on-dark);
    box-shadow: 0 30px 60px -28px rgb(13 15 13 / 0.6);
  }
  .plan--featured::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: radial-gradient(380px circle at var(--mx, 85%) var(--my, 0%), rgb(94 204 66 / 0.26), transparent 62%);
    transition: background-position var(--d-med) ease;
  }

  .plan__top { display: flex; align-items: center; justify-content: space-between; min-height: 28px; }
  .plan__index {
    font-family: var(--f-mono);
    font-size: var(--t-xs);
    font-weight: var(--w-medium);
    color: var(--c-ink-soft);
  }
  .plan__badge {
    padding: 4px 10px;
    border-radius: var(--r-pill);
    background: var(--c-green);
    color: var(--c-ink);
    font-family: var(--f-mono);
    font-size: 0.75rem;
    font-weight: var(--w-semibold);
    letter-spacing: 0;
  }
  .plan__name {
    margin-top: 40px;
    font-size: clamp(2rem, 1.6rem + 1.2vw, 2.6rem);
    font-weight: var(--w-bold);
    line-height: 1;
    letter-spacing: var(--ls-display);
  }
  .plan__desc { margin-top: 12px; color: var(--c-ink-soft); min-height: 3.2em; }
  .plan__time {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin-top: 20px;
    font-family: var(--f-mono);
    font-size: var(--t-xs);
    letter-spacing: 0;
    color: var(--c-ink-soft);
  }
  .plan--featured .plan__index,
  .plan--featured .plan__desc,
  .plan--featured .plan__time { color: var(--c-on-dark-soft); }

  .plan__features {
    display: grid;
    gap: 12px;
    margin-block: 24px 32px;
    padding-top: 24px;
    border-top: 1px solid var(--c-line);
    font-size: var(--t-sm);
  }
  .plan--featured .plan__features { border-color: var(--c-dark-line); }
  .plan__features li { display: flex; gap: 10px; align-items: flex-start; }
  .plan__features :global(svg) { flex: none; margin-top: 3px; color: var(--c-green-ink); }
  .plan--featured .plan__features :global(svg) { color: var(--c-green); }
  .plan :global(.plan__cta) { margin-top: auto; justify-content: space-between; }

  /* Garantias */
  .guarantees {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 12px;
    margin-top: 16px;
  }
  @media (min-width: 1100px) { .guarantees { grid-template-columns: repeat(4, 1fr); } }
  .guarantees li {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 4px;
    padding: 28px 18px 24px;
    border-radius: var(--r-md);
    background: var(--c-surface);
    box-shadow: inset 0 0 0 1px var(--c-line);
    font-size: var(--t-sm);
    line-height: 1.45;
    text-align: center;
    color: var(--c-ink-soft);
  }
  .guarantees strong { font-size: 1.0625rem; font-weight: var(--w-bold); letter-spacing: var(--ls-title); color: var(--c-ink); }
  .guarantees__icon {
    width: 64px;
    height: 64px;
    margin-bottom: 14px;
    filter: drop-shadow(0 10px 14px rgb(94 204 66 / 0.25));
    transition: transform var(--d-slow) var(--ease-spring);
  }
  .guarantees li:hover .guarantees__icon { transform: translateY(-4px) rotate(-4deg) scale(1.06); }
  @media (max-width: 639px) {
    .guarantees li { padding: 22px 12px 18px; font-size: var(--t-xs); }
    .guarantees__icon { width: 52px; height: 52px; }
  }
</style>
