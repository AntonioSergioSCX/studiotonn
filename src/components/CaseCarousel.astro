---
/**
 * Carrossel de cases do topo: card central em destaque, vizinhos espiando
 * atrás, cortado pela base do bloco do hero. Setas, teclado e arrastar.
 */
import Icon from './ui/Icon.astro';
import { cases } from '../content/site';

const total = cases.items.length;
---

<div
  class="cases"
  id="trabalhos"
  role="region"
  aria-roledescription="carrossel"
  aria-label={cases.label}
  data-cases
>
  <h2 class="sr-only">{cases.label}</h2>
  <p class="sr-only" aria-live="polite" data-live>Case 1 de {total}: {cases.items[0].name}</p>

  <div class="cases__track" data-track>
    {cases.items.map((c, i) => {
      const Tag = c.href ? 'a' : 'div';
      return (
        <article
          class="case"
          data-slide
          data-pos={i === 0 ? '0' : i === 1 ? '1' : i === total - 1 ? '-1' : 'far'}
          aria-roledescription="slide"
          aria-label={`${i + 1} de ${total}: ${c.name}`}
          aria-hidden={i === 0 ? undefined : 'true'}
          style={`--bg:${c.bg};--c:${c.color}`}
        >
          <Tag class="case__inner" {...(c.href ? { href: c.href } : {})}>
            <header class="case__head">
              <div class="case__id">
                <h3 class="case__name">{c.name}</h3>
                <p class="case__type">{c.type}</p>
              </div>
              <p class="case__result"><Icon name="check" size={14} />{c.result}</p>
            </header>

            <div class="case__art" aria-hidden="true">
              {c.image ? (
                <div class="mock-shot">
                  <div class="mock-site__bar"><i></i><i></i><i></i></div>
                  <img src={`${c.image}?v=1`} alt="" width="526" height="777" loading={i === 0 ? 'eager' : 'lazy'} decoding="async" />
                </div>
              ) : c.kind === 'site' && (
                <div class="mock-site">
                  <div class="mock-site__bar"><i></i><i></i><i></i></div>
                  <div class="mock-site__hero">
                    <b>{c.name}</b>
                    <span class="l"></span><span class="l s"></span>
                    <span class="mock-btn">Agendar consulta</span>
                  </div>
                  <div class="mock-site__grid"><span></span><span></span><span></span></div>
                </div>
              )}
              {c.kind === 'shop' && (
                <div class="mock-shop">
                  {[0, 1, 2, 3].map((n) => (
                    <span class="mock-shop__item"><i style={`--n:${n}`}></i><b></b><em></em></span>
                  ))}
                </div>
              )}
              {c.kind === 'app' && (
                <div class="mock-app">
                  <div class="mock-app__phone">
                    <b>Hoje</b>
                    <span class="mock-app__ring"></span>
                    <span class="mock-app__row"></span>
                    <span class="mock-app__row"></span>
                    <span class="mock-btn">Começar treino</span>
                  </div>
                </div>
              )}
              {c.kind === 'system' && (
                <div class="mock-sys">
                  <div class="mock-sys__side"><b></b><i></i><i></i><i></i><i></i></div>
                  <div class="mock-sys__main">
                    <div class="mock-sys__stats"><span><em></em><b></b></span><span><em></em><b></b></span><span><em></em><b></b></span></div>
                    <div class="mock-sys__chart">
                      {[46, 70, 54, 88, 62, 96, 78].map((h) => <i style={`--h:${h}%`}></i>)}
                    </div>
                  </div>
                </div>
              )}
            </div>
          </Tag>
        </article>
      );
    })}

    <button type="button" class="cases__arrow cases__arrow--prev" data-prev aria-label="Case anterior">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M14.5 6 8.5 12l6 6" /></svg>
    </button>
    <button type="button" class="cases__arrow cases__arrow--next" data-next aria-label="Próximo case">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m9.5 6 6 6-6 6" /></svg>
    </button>
  </div>
</div>

<script>
  const root = document.querySelector<HTMLElement>('[data-cases]');
  if (root) {
    const slides = [...root.querySelectorAll<HTMLElement>('[data-slide]')];
    const live = root.querySelector<HTMLElement>('[data-live]')!;
    const track = root.querySelector<HTMLElement>('[data-track]')!;
    const n = slides.length;
    let active = 0;

    const render = () => {
      slides.forEach((el, i) => {
        let pos = (((i - active) % n) + n) % n;
        if (pos > n / 2) pos -= n;
        el.dataset.pos = Math.abs(pos) > 1 ? 'far' : String(pos);
        const current = pos === 0;
        el.toggleAttribute('inert', !current);
        if (current) el.removeAttribute('aria-hidden');
        else el.setAttribute('aria-hidden', 'true');
      });
      const name = slides[active].querySelector('.case__name')?.textContent ?? '';
      live.textContent = `Case ${active + 1} de ${n}: ${name}`;
    };
    const go = (step: number) => { active = (active + step + n) % n; render(); };

    root.querySelector('[data-prev]')!.addEventListener('click', () => go(-1));
    root.querySelector('[data-next]')!.addEventListener('click', () => go(1));
    root.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowLeft') { e.preventDefault(); go(-1); }
      if (e.key === 'ArrowRight') { e.preventDefault(); go(1); }
    });

    // Clicar num card lateral traz ele para o centro
    slides.forEach((el) => el.addEventListener('click', () => {
      const pos = Number(el.dataset.pos);
      if (pos === 1 || pos === -1) go(pos);
    }));

    // Arrastar (toque ou mouse)
    let startX: number | null = null;
    track.addEventListener('pointerdown', (e) => { startX = e.clientX; });
    track.addEventListener('pointerup', (e) => {
      if (startX === null) return;
      const dx = e.clientX - startX;
      startX = null;
      if (Math.abs(dx) > 40) go(dx < 0 ? 1 : -1);
    });

    render();
  }
</script>

<style>
  .cases {
    --w: min(58%, 760px);
    --track-h: clamp(300px, 34vw, 430px);
    position: relative;
    align-self: stretch;
    width: 100%;
    margin-top: clamp(48px, 6vw, 72px);
  }
  .cases__track {
    position: relative;
    height: var(--track-h);
    touch-action: pan-y;
  }

  /* Slides */
  .case {
    --x: 0;
    --y: 0px;
    --s: 1;
    position: absolute;
    top: 0;
    left: 50%;
    width: var(--w);
    transform: translateX(-50%) translateX(calc(var(--x) * 100%)) translateY(var(--y)) scale(var(--s));
    transform-origin: 50% 0;
    transition:
      transform 0.9s var(--ease-out),
      opacity 0.6s ease,
      filter 0.9s var(--ease-out);
    will-change: transform;
  }
  .case[data-pos='0'] { z-index: 3; }
  .case[data-pos='-1'],
  .case[data-pos='1'] { --y: 36px; --s: 0.9; z-index: 2; cursor: pointer; filter: saturate(0.75); }
  .case[data-pos='-1'] { --x: -0.36; }
  .case[data-pos='1'] { --x: 0.36; }
  .case[data-pos='far'] { --y: 60px; --s: 0.8; opacity: 0; z-index: 1; pointer-events: none; }
  .case[data-pos='-1']:hover,
  .case[data-pos='1']:hover { --y: 28px; filter: saturate(1); }

  .case__inner {
    display: flex;
    flex-direction: column;
    height: calc(var(--track-h) + 80px);
    padding: 10px;
    border-radius: var(--r-lg);
    background: var(--c-surface);
    box-shadow: 0 0 0 1px var(--c-line), 0 30px 60px -30px rgb(13 15 13 / 0.35);
  }
  .case__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding: 10px 12px 14px;
    text-align: left;
    transition: opacity 0.5s ease;
  }
  .case__id { min-width: 0; }
  .case__name {
    font-size: 1.125rem;
    font-weight: var(--w-bold);
    letter-spacing: var(--ls-title);
    line-height: 1.2;
  }
  .case__type {
    font-family: var(--f-mono);
    font-size: 0.75rem;
    letter-spacing: 0;
    color: var(--c-ink-soft);
  }
  .case__result {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    flex: 0 1 auto;
    min-width: 0;
    max-width: 100%;
    padding: 6px 12px;
    border-radius: var(--r-pill);
    background: var(--c-green-soft);
    color: #23611a;
    font-size: var(--t-xs);
    font-weight: var(--w-bold);
    white-space: nowrap;
  }
  .case__art {
    position: relative;
    flex: 1;
    border-radius: calc(var(--r-lg) - 10px);
    background: var(--bg);
    overflow: hidden;
  }

  /* Setas sobre as bordas do card central */
  .cases__arrow {
    position: absolute;
    top: 42%;
    z-index: 4;
    display: grid;
    place-items: center;
    width: 52px;
    height: 52px;
    border-radius: 50%;
    background: var(--c-surface);
    color: var(--c-ink);
    box-shadow: 0 0 0 1px var(--c-line), 0 10px 24px -8px rgb(13 15 13 / 0.25);
    transform: translate(-50%, -50%);
    transition: transform var(--d-med) var(--ease-spring), background-color var(--d-fast) ease, color var(--d-fast) ease;
  }
  .cases__arrow--prev { left: calc(50% - var(--w) / 2); }
  .cases__arrow--next { left: calc(50% + var(--w) / 2); }
  @media (hover: hover) {
    .cases__arrow:hover { background: var(--c-ink); color: var(--c-on-dark); transform: translate(-50%, -50%) scale(1.06); }
  }
  .cases__arrow:active { transform: translate(-50%, -50%) scale(0.96); }

  @media (max-width: 759px) {
    .cases { --w: 84%; --track-h: 330px; }
    .case[data-pos='-1'] { --x: -0.2; }
    .case[data-pos='1'] { --x: 0.2; }
    .case__head { flex-direction: column; align-items: flex-start; gap: 8px; }
    /* Selo quebra linha em vez de vazar do card */
    .case__result { white-space: normal; line-height: 1.3; padding: 6px 10px; }
    .case__result :global(svg) { flex: none; }
    /* Cards laterais mostram só a imagem: nada de texto cortado nas bordas */
    .case:not([data-pos='0']) .case__head { opacity: 0; }
    .cases__arrow { width: 44px; height: 44px; top: 52%; }
    .cases__arrow--prev { left: calc(50% - var(--w) / 2 + 6px); }
    .cases__arrow--next { left: calc(50% + var(--w) / 2 - 6px); }
  }

  /* Mocks dos projetos */
  .mock-btn {
    align-self: flex-start;
    padding: 7px 14px;
    border-radius: 999px;
    background: var(--c);
    color: #fff;
    font-size: 11px;
    font-weight: var(--w-bold);
  }
  .mock-site {
    position: absolute;
    inset: 10% 9% -6%;
    display: flex;
    flex-direction: column;
    border-radius: 14px 14px 0 0;
    background: #fff;
    box-shadow: var(--shadow-2);
    overflow: hidden;
  }
  .mock-site__bar { display: flex; gap: 5px; padding: 10px 12px; border-bottom: 1px solid var(--c-line); }
  .mock-site__bar i { width: 8px; height: 8px; border-radius: 50%; background: #dcdbd4; }
  .mock-site__hero {
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding: 26px;
    background: linear-gradient(120deg, color-mix(in srgb, var(--c) 12%, #fff), #fff 70%);
  }
  .mock-site__hero b { font-weight: var(--w-heavy); font-size: clamp(22px, 2.8vw, 38px); line-height: 1; letter-spacing: var(--ls-display); color: var(--c); }
  .mock-site__hero .l { height: 7px; width: 64%; border-radius: 4px; background: var(--c-surface-2); }
  .mock-site__hero .l.s { width: 44%; }
  .mock-site__grid { display: grid; grid-template-columns: repeat(3, 1fr); grid-auto-rows: 90px; gap: 10px; padding: 4px 26px 26px; }
  .mock-site__grid span { border-radius: 10px; background: color-mix(in srgb, var(--c) 10%, var(--c-surface-2)); }

  /* Print real do site: a imagem desce devagar ao passar o mouse, como quem rola a página */
  .mock-shot {
    position: absolute;
    inset: 8% 7% -6%;
    display: flex;
    flex-direction: column;
    border-radius: 14px 14px 0 0;
    background: #fff;
    box-shadow: var(--shadow-2);
    overflow: hidden;
  }
  .mock-shot img {
    flex: 1;
    min-height: 0;
    width: 100%;
    object-fit: cover;
    object-position: 50% 0;
    transition: object-position 6s cubic-bezier(0.45, 0, 0.25, 1);
  }
  @media (hover: hover) {
    .case[data-pos='0']:hover .mock-shot img { object-position: 50% 100%; }
  }

  .mock-shop {
    position: absolute;
    inset: 12% 7% -10%;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 10px;
    align-items: start;
  }
  .mock-shop__item { display: grid; gap: 6px; padding: 8px; border-radius: 12px; background: #fff; box-shadow: var(--shadow-1); }
  .mock-shop__item:nth-child(even) { margin-top: 24px; }
  .mock-shop__item i { display: block; aspect-ratio: 3 / 4; border-radius: 8px; background: color-mix(in srgb, var(--c) calc(18% + var(--n) * 14%), #f6efe9); }
  .mock-shop__item b { height: 6px; width: 80%; border-radius: 4px; background: var(--c-surface-2); }
  .mock-shop__item em { height: 6px; width: 40%; border-radius: 4px; background: var(--c); }

  .mock-app { position: absolute; inset: 0; display: grid; place-items: end center; }
  .mock-app__phone {
    display: flex;
    flex-direction: column;
    gap: 10px;
    width: 40%;
    max-width: 200px;
    height: 88%;
    padding: 22px 16px;
    border-radius: 28px 28px 0 0;
    border: 6px solid var(--c-ink);
    border-bottom: 0;
    background: #fff;
  }
  .mock-app__phone b { font-weight: var(--w-heavy); font-size: 20px; letter-spacing: var(--ls-title); }
  .mock-app__ring {
    align-self: center;
    width: 70px;
    height: 70px;
    border-radius: 50%;
    background: conic-gradient(var(--c) 0 72%, var(--c-surface-2) 0);
    mask: radial-gradient(circle, transparent 54%, #000 55%);
    -webkit-mask: radial-gradient(circle, transparent 54%, #000 55%);
  }
  .mock-app__row { height: 26px; border-radius: 8px; background: var(--c-surface-2); }
  .mock-app .mock-btn { align-self: stretch; text-align: center; }

  .mock-sys {
    position: absolute;
    inset: 10% 7% -6%;
    display: grid;
    grid-template-columns: 22% 1fr;
    border-radius: 14px 14px 0 0;
    background: #fff;
    box-shadow: var(--shadow-2);
    overflow: hidden;
  }
  .mock-sys__side { display: flex; flex-direction: column; gap: 10px; padding: 16px 12px; background: var(--c); }
  .mock-sys__side b { height: 12px; width: 70%; border-radius: 4px; background: rgb(255 255 255 / 0.9); margin-bottom: 8px; }
  .mock-sys__side i { height: 8px; border-radius: 4px; background: rgb(255 255 255 / 0.3); }
  .mock-sys__main { display: flex; flex-direction: column; gap: 12px; padding: 16px; }
  .mock-sys__stats { display: grid; grid-template-columns: repeat(3, 1fr); gap: 8px; }
  .mock-sys__stats span { display: grid; gap: 6px; padding: 10px; border-radius: 10px; background: var(--c-bg); }
  .mock-sys__stats em { height: 6px; width: 50%; border-radius: 4px; background: var(--c-surface-2); }
  .mock-sys__stats b { height: 12px; width: 70%; border-radius: 4px; background: color-mix(in srgb, var(--c) 70%, #fff); }
  .mock-sys__chart { flex: 1; display: flex; align-items: flex-end; gap: 8%; padding: 12px; border-radius: 10px; background: var(--c-bg); min-height: 90px; }
  .mock-sys__chart i { flex: 1; height: var(--h); border-radius: 4px 4px 0 0; background: color-mix(in srgb, var(--c) 55%, #fff); }
  .mock-sys__chart i:nth-child(6) { background: var(--c-green); }
</style>
