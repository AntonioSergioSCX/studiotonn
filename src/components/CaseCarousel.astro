---
/**
 * Carrossel de cases do topo: card central em destaque, vizinhos espiando
 * atrás, cortado pela base do bloco do hero. Setas, teclado e arrastar.
 */
import Icon from './ui/Icon.astro';
import { cases } from '../content/site';

const total = cases.items.length;
---

<div
  class="cases"
  id="trabalhos"
  role="region"
  aria-roledescription="carrossel"
  aria-label={cases.label}
  data-cases
>
  <h2 class="sr-only">{cases.label}</h2>
  <p class="sr-only" aria-live="polite" data-live>Case 1 de {total}: {cases.items[0].name}</p>

  <div class="cases__track" data-track>
    {cases.items.map((c, i) => {
      const Tag = c.href ? 'a' : 'div';
      return (
        <article
          class="case"
          data-slide
          data-pos={i === 0 ? '0' : i === 1 ? '1' : i === total - 1 ? '-1' : 'far'}
          aria-roledescription="slide"
          aria-label={`${i + 1} de ${total}: ${c.name}`}
          aria-hidden={i === 0 ? undefined : 'true'}
          style={`--bg:${c.bg};--c:${c.color}`}
        >
          <Tag class="case__inner" {...(c.href ? { href: c.href } : {})}>
            <header class="case__head">
              <div class="case__id">
                <h3 class="case__name">{c.name}</h3>
                <p class="case__type">{c.type}</p>
              </div>
              <p class="case__result"><Icon name="check" size={14} />{c.result}</p>
            </header>

            <div class="case__art">
              {c.image ? (
                <div class="mock-shot">
                  <div class="mock-site__bar" aria-hidden="true"><i></i><i></i><i></i></div>
                  <span class="mock-shot__view">
                    <img
                      src={`${c.image}.webp?v=2`}
                      srcset={`${c.image}-640.webp?v=2 640w, ${c.image}.webp?v=2 1240w`}
                      sizes="(min-width: 760px) 640px, 80vw"
                      alt={c.alt}
                      width="1240"
                      height="760"
                      loading={i === 0 ? 'eager' : 'lazy'}
                      fetchpriority={i === 0 ? 'high' : undefined}
                      decoding="async"
                    />
                  </span>
                </div>
              ) : c.screens ? (
                <div class="mock-screens" role="img" aria-label={c.alt}>
                  {/* lista duplicada: a faixa anda até a metade e recomeça sem emenda */}
                  <div class="mock-screens__track" aria-hidden="true">
                    {[...c.screens, ...c.screens].map((src) => (
                      <span class="mock-screens__phone">
                        <img src={`${src}.webp?v=1`} alt="" width="360" height="779" loading="lazy" decoding="async" />
                      </span>
                    ))}
                  </div>
                </div>
              ) : null}
            </div>
          </Tag>
        </article>
      );
    })}

    <button type="button" class="cases__arrow cases__arrow--prev" data-prev aria-label="Case anterior">
      <Icon name="caret-left" size={20} />
    </button>
    <button type="button" class="cases__arrow cases__arrow--next" data-next aria-label="Próximo case">
      <Icon name="caret-right" size={20} />
    </button>
  </div>
</div>

<script>
  const root = document.querySelector<HTMLElement>('[data-cases]');
  if (root) {
    const slides = [...root.querySelectorAll<HTMLElement>('[data-slide]')];
    const live = root.querySelector<HTMLElement>('[data-live]')!;
    const track = root.querySelector<HTMLElement>('[data-track]')!;
    const n = slides.length;
    let active = 0;

    const render = () => {
      slides.forEach((el, i) => {
        let pos = (((i - active) % n) + n) % n;
        if (pos > n / 2) pos -= n;
        el.dataset.pos = Math.abs(pos) > 1 ? 'far' : String(pos);
        const current = pos === 0;
        el.toggleAttribute('inert', !current);
        if (current) el.removeAttribute('aria-hidden');
        else el.setAttribute('aria-hidden', 'true');
      });
      const name = slides[active].querySelector('.case__name')?.textContent ?? '';
      live.textContent = `Case ${active + 1} de ${n}: ${name}`;
    };
    const go = (step: number) => { active = (active + step + n) % n; render(); };

    // Troca sozinho a cada 4,5s. Pausa com mouse em cima, foco dentro, aba escondida
    // ou carrossel fora da tela; qualquer interação reinicia a contagem.
    const DELAY = 4500;
    const still = matchMedia('(prefers-reduced-motion: reduce)');
    let timer = 0;
    let hovered = false;
    let focused = false;
    let visible = true;
    const stop = () => { clearInterval(timer); timer = 0; };
    const start = () => {
      stop();
      if (still.matches || hovered || focused || !visible || document.hidden) return;
      timer = window.setInterval(() => go(1), DELAY);
    };
    const user = (step: number) => { go(step); start(); };

    root.querySelector('[data-prev]')!.addEventListener('click', () => user(-1));
    root.querySelector('[data-next]')!.addEventListener('click', () => user(1));
    root.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowLeft') { e.preventDefault(); user(-1); }
      if (e.key === 'ArrowRight') { e.preventDefault(); user(1); }
    });

    // Clicar num card lateral traz ele para o centro
    slides.forEach((el) => el.addEventListener('click', () => {
      const pos = Number(el.dataset.pos);
      if (pos === 1 || pos === -1) user(pos);
    }));

    // Arrastar (toque ou mouse)
    let startX: number | null = null;
    track.addEventListener('pointerdown', (e) => { startX = e.clientX; });
    track.addEventListener('pointerup', (e) => {
      if (startX === null) return;
      const dx = e.clientX - startX;
      startX = null;
      if (Math.abs(dx) > 40) user(dx < 0 ? 1 : -1);
    });

    render();

    root.addEventListener('pointerenter', (e) => { if (e.pointerType === 'mouse') { hovered = true; start(); } });
    root.addEventListener('pointerleave', () => { hovered = false; start(); });
    root.addEventListener('focusin', () => { focused = true; start(); });
    root.addEventListener('focusout', (e) => {
      if (!root.contains(e.relatedTarget as Node | null)) { focused = false; start(); }
    });
    document.addEventListener('visibilitychange', start);
    still.addEventListener('change', start);
    new IntersectionObserver(([entry]) => { visible = entry.isIntersecting; start(); }, { threshold: 0.35 }).observe(root);
    start();
  }
</script>

<style>
  .cases {
    --w: min(58%, 760px);
    --track-h: clamp(300px, 34vw, 430px);
    position: relative;
    align-self: stretch;
    width: 100%;
    margin-top: clamp(48px, 6vw, 72px);
  }
  .cases__track {
    position: relative;
    height: var(--track-h);
    touch-action: pan-y;
  }

  /* Slides */
  .case {
    --x: 0;
    --y: 0px;
    --s: 1;
    position: absolute;
    top: 0;
    left: 50%;
    width: var(--w);
    transform: translateX(-50%) translateX(calc(var(--x) * 100%)) translateY(var(--y)) scale(var(--s));
    transform-origin: 50% 0;
    transition:
      transform 0.9s var(--ease-out),
      opacity 0.6s ease,
      filter 0.9s var(--ease-out);
    will-change: transform;
  }
  .case[data-pos='0'] { z-index: 3; }
  .case[data-pos='-1'],
  .case[data-pos='1'] { --y: 36px; --s: 0.9; z-index: 2; cursor: pointer; filter: saturate(0.75); }
  .case[data-pos='-1'] { --x: -0.36; }
  .case[data-pos='1'] { --x: 0.36; }
  .case[data-pos='far'] { --y: 60px; --s: 0.8; opacity: 0; z-index: 1; pointer-events: none; }
  .case[data-pos='-1']:hover,
  .case[data-pos='1']:hover { --y: 28px; filter: saturate(1); }

  .case__inner {
    display: flex;
    flex-direction: column;
    height: calc(var(--track-h) + 80px);
    padding: 10px;
    border-radius: var(--r-lg);
    background: var(--c-surface);
    box-shadow: 0 0 0 1px var(--c-line), 0 30px 60px -30px rgb(13 15 13 / 0.35);
  }
  .case__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding: 10px 12px 14px;
    text-align: left;
    transition: opacity 0.5s ease;
  }
  .case__id { min-width: 0; }
  .case__name {
    font-size: 1.125rem;
    font-weight: var(--w-bold);
    letter-spacing: var(--ls-title);
    line-height: 1.2;
  }
  .case__type {
    font-size: var(--t-xs);
    color: var(--c-ink-soft);
  }
  .case__result {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    flex: 0 1 auto;
    min-width: 0;
    max-width: 100%;
    padding: 6px 12px;
    border-radius: var(--r-pill);
    background: var(--c-green-soft);
    color: #23611a;
    font-size: var(--t-xs);
    font-weight: var(--w-bold);
    white-space: nowrap;
  }
  .case__art {
    position: relative;
    flex: 1;
    border-radius: calc(var(--r-lg) - 10px);
    background: var(--bg);
    overflow: hidden;
  }

  /* Setas sobre as bordas do card central */
  .cases__arrow {
    position: absolute;
    top: 42%;
    z-index: 4;
    display: grid;
    place-items: center;
    width: 52px;
    height: 52px;
    border-radius: 50%;
    background: var(--c-surface);
    color: var(--c-ink);
    box-shadow: 0 0 0 1px var(--c-line), 0 10px 24px -8px rgb(13 15 13 / 0.25);
    transform: translate(-50%, -50%);
    transition: transform var(--d-med) var(--ease-spring), background-color var(--d-fast) ease, color var(--d-fast) ease;
  }
  .cases__arrow--prev { left: calc(50% - var(--w) / 2); }
  .cases__arrow--next { left: calc(50% + var(--w) / 2); }
  @media (hover: hover) {
    .cases__arrow:hover { background: var(--c-ink); color: var(--c-on-dark); transform: translate(-50%, -50%); }
  }
  .cases__arrow:active { background: var(--c-ink-soft); color: var(--c-on-dark); }

  @media (max-width: 759px) {
    .cases { --w: 84%; --track-h: 330px; }
    .case[data-pos='-1'] { --x: -0.2; }
    .case[data-pos='1'] { --x: 0.2; }
    .case__head { flex-direction: column; align-items: flex-start; gap: 8px; }
    /* Selo quebra linha em vez de vazar do card */
    .case__result { white-space: normal; line-height: 1.3; padding: 6px 10px; }
    .case__result :global(svg) { flex: none; }
    /* Cards laterais mostram só a imagem: nada de texto cortado nas bordas */
    .case:not([data-pos='0']) .case__head { opacity: 0; }
    .cases__arrow { width: 44px; height: 44px; top: 52%; }
    .cases__arrow--prev { left: calc(50% - var(--w) / 2 + 6px); }
    .cases__arrow--next { left: calc(50% + var(--w) / 2 - 6px); }
  }

  /* Imagens dos projetos */
  .mock-site__bar { display: flex; gap: 5px; padding: 10px 12px; border-bottom: 1px solid var(--c-line); }
  .mock-site__bar i { width: 8px; height: 8px; border-radius: 50%; background: #dcdbd4; }
  /* Print real do site: a imagem desce devagar ao passar o mouse, como quem rola a página */
  .mock-shot {
    position: absolute;
    inset: 8% 7% -6%;
    display: flex;
    flex-direction: column;
    border-radius: 14px 14px 0 0;
    background: #fff;
    box-shadow: var(--shadow-2);
    overflow: hidden;
  }
  /* Imagem sempre na largura toda (sem cortar as laterais); se for mais alta que a janela, desce no hover */
  .mock-shot__view {
    flex: 1;
    min-height: 0;
    overflow: hidden;
    container-type: size;
  }
  .mock-shot img {
    width: 100%;
    height: auto;
    transition: translate 6s cubic-bezier(0.45, 0, 0.25, 1);
  }
  /* No celular a janela acompanha a altura do print, sem faixa vazia embaixo */
  @media (max-width: 759px) {
    .mock-shot { bottom: auto; max-height: 100%; }
    .mock-shot__view { flex: none; container-type: normal; }
  }
  @media (hover: hover) {
    .case[data-pos='0']:hover .mock-shot img { translate: 0 min(0px, calc(100cqh - 100%)); }
  }

  /* Telas do app em celulares, passando de lado sem parar */
  .mock-screens {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: flex-start;
    padding-top: 7%;
    overflow: hidden;
    mask-image: linear-gradient(90deg, transparent, #000 8%, #000 92%, transparent);
    -webkit-mask-image: linear-gradient(90deg, transparent, #000 8%, #000 92%, transparent);
  }
  .mock-screens__track {
    display: flex;
    gap: 20px;
    padding-left: 20px;
    animation: screens 32s linear infinite;
  }
  .mock-screens__phone {
    flex: none;
    height: calc(var(--track-h) * 0.74);
    aspect-ratio: 360 / 779;
    padding: 5px;
    border-radius: 26px;
    background: #0b0b0b;
    box-shadow: 0 0 0 1px rgb(13 15 13 / 0.12), 0 24px 40px -22px rgb(13 15 13 / 0.55);
  }
  .mock-screens__phone img { width: 100%; height: 100%; border-radius: 21px; object-fit: cover; }
  @keyframes screens { to { transform: translateX(-50%); } }
  @media (hover: hover) {
    .case:hover .mock-screens__track { animation-play-state: paused; }
  }

</style>
