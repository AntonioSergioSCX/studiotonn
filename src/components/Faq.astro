---
import SectionHead from './ui/SectionHead.astro';
import Icon from './ui/Icon.astro';
import { faq, site, whatsappLink } from '../content/site';
---

<section class="section faq" id="duvidas" aria-labelledby="duvidas-title">
  <div class="container">
    <SectionHead eyebrow={faq.eyebrow} title={faq.title} id="duvidas-title" />

    <div class="faq__list">
      {faq.items.map((item, i) => (
        <details class="qa" name="faq" open={i === 0} data-reveal style={`--i:${i}`}>
          <summary>
            <span>{item.q}</span>
            <span class="qa__icon" aria-hidden="true"><Icon name="plus" size={18} /></span>
          </summary>
          <div class="qa__a"><p>{item.a}</p></div>
        </details>
      ))}
    </div>

    <p class="faq__aside">
      {faq.aside}
      <a href={whatsappLink(`Oi, ${site.owner}! Tenho uma dúvida antes de pedir orçamento:`)} target="_blank" rel="noopener">
        {faq.asideCta} <Icon name="arrow" size={16} />
      </a>
    </p>
  </div>
</section>

<style>
  .faq { padding-top: 0; }
  .faq__list {
    display: grid;
    gap: 10px;
    max-width: 820px;
    margin-inline: auto;
  }
  .qa {
    border-radius: var(--r-md);
    background: var(--c-surface);
    box-shadow: inset 0 0 0 1px var(--c-line);
    transition: box-shadow var(--d-med) ease;
  }
  .qa[open] { box-shadow: inset 0 0 0 1px var(--c-line), var(--shadow-1); }
  .qa summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    padding: 20px 20px 20px 24px;
    font-size: 1.125rem;
    font-weight: var(--w-bold);
    letter-spacing: var(--ls-title);
    cursor: pointer;
    list-style: none;
  }
  .qa summary::-webkit-details-marker { display: none; }
  .qa__icon {
    display: grid;
    place-items: center;
    flex: none;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background: var(--c-bg);
    transition: transform var(--d-med) var(--ease-spring), background-color var(--d-fast) ease;
  }
  .qa[open] .qa__icon { transform: rotate(45deg); background: var(--c-green); }
  .qa__a { padding: 0 72px 22px 24px; color: var(--c-ink-soft); }

  /* Abertura suave onde o navegador suporta */
  .qa::details-content {
    block-size: 0;
    overflow: hidden;
    transition: block-size var(--d-med) var(--ease-out), content-visibility var(--d-med) allow-discrete;
  }
  .qa[open]::details-content { block-size: auto; }

  .faq__aside { margin-top: 28px; text-align: center; color: var(--c-ink-soft); }
  .faq__aside a {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    margin-left: 4px;
    font-weight: var(--w-bold);
    color: var(--c-green-ink);
    text-decoration: underline;
    text-underline-offset: 4px;
    text-decoration-thickness: 1.5px;
  }
  @media (max-width: 559px) {
    .qa summary { font-size: 1rem; padding: 18px 16px 18px 18px; }
    .qa__a { padding: 0 18px 20px; }
  }
</style>
