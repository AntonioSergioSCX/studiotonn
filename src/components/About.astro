---
/**
 * Quem faz: um card cinza grande. À esquerda logo, texto e dois números;
 * à direita um painel claro com a foto e os selos (imagem do Figma), nome e cargo em texto.
 */
import SectionHead from './ui/SectionHead.astro';
import Logo from './ui/Logo.astro';
import { about } from '../content/site';
---

<section class="section about" id="sobre" aria-labelledby="sobre-title">
  <div class="container">
    <SectionHead eyebrow={about.eyebrow} title={about.title} lead={about.lead} id="sobre-title" />

    <div class="about__card" data-reveal>
      <div class="about__copy">
        <Logo class="about__logo" />
        {about.paragraphs.map((p) => <p>{p}</p>)}
        <dl class="facts">
          {about.facts.map((f) => (
            <div>
              <dt>{f.label}</dt>
              <dd>{f.value}</dd>
            </div>
          ))}
        </dl>
      </div>

      <figure class="about__person">
        <img
          src={`${about.card}.webp?v=1`}
          srcset={`${about.card}.webp?v=1 305w, ${about.card}@2x.webp?v=1 610w`}
          sizes="(min-width: 900px) 380px, 80vw"
          alt={`${about.name}, com selos de atendimento personalizado e mais de 14 clientes`}
          width="610"
          height="345"
          loading="lazy"
          decoding="async"
        />
        <figcaption>
          <strong>{about.name}</strong>
          <span>{about.role}</span>
        </figcaption>
      </figure>
    </div>
  </div>
</section>

<style>
  .about { padding-top: 0; }
  .about :global(.sh__title) { max-width: 24ch; font-weight: var(--w-medium); }

  .about__card {
    display: grid;
    gap: 20px;
    padding: 12px;
    border-radius: 24px;
    background: #ecebe7;
  }
  @media (min-width: 900px) {
    .about__card { grid-template-columns: 1.5fr 1fr; align-items: stretch; }
  }

  .about__copy { display: flex; flex-direction: column; gap: 18px; padding: clamp(16px, 2.4vw, 32px); }
  .about__copy :global(.about__logo) { align-self: flex-start; height: 36px; width: auto; margin-bottom: 8px; color: var(--c-ink); }
  .about__copy p { font-size: var(--t-lg); line-height: 1.5; font-weight: var(--w-medium); color: #3b3f3b; }

  .facts { display: flex; flex-wrap: wrap; gap: 12px 56px; margin-top: auto; padding-top: 16px; }
  .facts div { display: flex; flex-direction: row-reverse; align-items: baseline; gap: 12px; }
  .facts dd { font-size: var(--t-lg); font-weight: var(--w-medium); color: var(--c-ink); }
  .facts dt { font-size: var(--t-lg); color: var(--c-ink-soft); }

  /* Painel claro com a foto */
  .about__person {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 10px;
    padding: 28px 20px 32px;
    border-radius: 16px;
    background: #f6f6f3;
    text-align: center;
  }
  .about__person img { width: min(100%, 380px); height: auto; }
  .about__person figcaption { display: flex; flex-direction: column; gap: 4px; }
  .about__person strong { font-size: var(--t-lg); font-weight: var(--w-medium); color: var(--c-ink); }
  .about__person span { font-size: var(--t-md); color: var(--c-ink-soft); }
</style>
