---
/**
 * Selo acima do título do hero: avatares passando de lado (laterais esmaecidas)
 * e uma frase curta. A lista é duplicada para a faixa recomeçar sem emenda.
 */
import { hero } from '../content/site';

const { text, avatars } = hero.badge;
---

<p class="badge">
  <span class="badge__faces" aria-hidden="true">
    <span class="badge__track">
      {[...avatars, ...avatars].map((a) => (
        <span class="badge__face" style={`--bg:${a.bg};--fg:${a.color}`}>
          {a.photo ? <img src={a.photo} alt="" width="28" height="28" loading="eager" decoding="async" /> : a.initials}
        </span>
      ))}
    </span>
  </span>
  <span class="badge__text">{text}</span>
</p>

<style>
  /* Borda com um brilho verde que percorre o contorno */
  @property --a {
    syntax: '<angle>';
    initial-value: 0deg;
    inherits: false;
  }
  .badge {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 5px 16px 5px 5px;
    border-radius: var(--r-pill);
    box-shadow: 0 1px 2px rgb(13 15 13 / 0.04), 0 8px 24px -12px rgb(13 15 13 / 0.18);
    font-size: var(--t-sm);
    font-weight: var(--w-semibold);
    white-space: nowrap;
    color: var(--c-ink);
    isolation: isolate;
  }
  /* contorno: gradiente girando por baixo, miolo claro por cima (1px de borda) */
  .badge::before,
  .badge::after {
    content: '';
    position: absolute;
    border-radius: inherit;
  }
  .badge::before {
    inset: 0;
    z-index: -2;
    background: conic-gradient(from var(--a), var(--c-line) 0 62%, var(--c-green) 80%, var(--c-line) 96%);
    animation: trail 5s linear infinite;
  }
  .badge::after {
    inset: 1px;
    z-index: -1;
    background: #fbfbf8;
  }
  @keyframes trail { to { --a: 360deg; } }

  .badge__faces {
    width: 112px;
    overflow: hidden;
    border-radius: var(--r-pill);
    mask-image: linear-gradient(90deg, transparent, #000 22%, #000 78%, transparent);
    -webkit-mask-image: linear-gradient(90deg, transparent, #000 22%, #000 78%, transparent);
  }
  .badge__track {
    display: flex;
    width: max-content;
    animation: faces 16s linear infinite;
  }
  .badge__face {
    display: grid;
    place-items: center;
    flex: none;
    width: 30px;
    height: 30px;
    margin-right: -6px;
    border-radius: 50%;
    background: var(--bg);
    color: var(--fg);
    box-shadow: 0 0 0 2px #fff;
    font-size: 0.625rem;
    font-weight: var(--w-bold);
    letter-spacing: 0.02em;
    overflow: hidden;
  }
  .badge__face img { width: 100%; height: 100%; object-fit: cover; }
  @media (max-width: 400px) {
    .badge { gap: 8px; padding-right: 14px; font-size: var(--t-xs); }
    .badge__faces { width: 88px; }
  }
  /* metade da faixa = uma volta completa da lista */
  @keyframes faces { to { transform: translateX(-50%); } }
</style>
