---
import Button from './ui/Button.astro';
import Icon from './ui/Icon.astro';
import { finalCta, whatsappLink } from '../content/site';
import { splitAccent } from '../lib/format';
---

<section class="final" id="contato" aria-labelledby="contato-title">
  <div class="container">
    <div class="final__card on-dark">
      <div class="final__aurora" aria-hidden="true"><span class="final__light"></span><span class="final__dots"></span></div>
      <p class="final__kicker" data-reveal>{finalCta.kicker}</p>
      <h2 class="final__title" id="contato-title" data-reveal style="--i:1">
        {splitAccent(finalCta.title).map((part, i) => (i % 2 ? <span class="accent">{part}</span> : part))}
      </h2>
      <p class="final__text" data-reveal style="--i:2">{finalCta.text}</p>
      <div class="final__ctas" data-reveal style="--i:3">
        <Button href={whatsappLink()} size="lg" icon="whatsapp" external>{finalCta.cta}</Button>
      </div>
      <p class="final__reassure"><Icon name="check" size={16} />{finalCta.reassurance}</p>
    </div>
  </div>
</section>

<style>
  .final { padding-bottom: clamp(24px, 4vw, 40px); }
  .final__card {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    /* Texto na parte escura; a luz verde nasce na base, abaixo do botão */
    padding: clamp(64px, 9vw, 112px) clamp(20px, 5vw, 64px) clamp(104px, 12vw, 160px);
    border-radius: var(--r-xl);
    background: #000;
    color: var(--c-on-dark);
    text-align: center;
    overflow: hidden;
    isolation: isolate;
  }
  /* Degradê em CSS puro: luz verde-limão subindo da base, faixas verticais e trama de pontos */
  .final__aurora {
    position: absolute;
    inset: 0;
    z-index: -1;
    pointer-events: none;
    /* faixas verticais suaves, mais visíveis perto da base */
    background: repeating-linear-gradient(90deg, rgb(255 255 255 / 0.035) 0 1px, transparent 1px 7.14%);
    mask-image: linear-gradient(to top, #000 0%, rgb(0 0 0 / 0.6) 35%, transparent 70%);
    -webkit-mask-image: linear-gradient(to top, #000 0%, rgb(0 0 0 / 0.6) 35%, transparent 70%);
  }
  .final__light,
  .final__dots { position: absolute; inset: 0; }
  .final__light {
    background:
      radial-gradient(42% 38% at 30% 108%, #b6f23a 0%, rgb(150 230 50 / 0.75) 28%, transparent 72%),
      radial-gradient(44% 42% at 66% 108%, #3cf07a 0%, rgb(40 220 110 / 0.7) 30%, transparent 72%),
      radial-gradient(70% 60% at 50% 112%, rgb(20 160 80 / 0.85) 0%, rgb(10 90 50 / 0.5) 40%, transparent 75%),
      radial-gradient(30% 40% at 4% 100%, rgb(80 120 20 / 0.6), transparent 70%),
      radial-gradient(30% 40% at 96% 100%, rgb(10 100 60 / 0.6), transparent 70%);
    transform-origin: 50% 100%;
    animation: breathe 9s var(--ease-in-out) infinite alternate;
  }
  .final__dots {
    background: radial-gradient(circle, rgb(200 255 210 / 0.45) 0 1px, transparent 1.6px) 0 0 / 12px 12px;
    mask-image: radial-gradient(40% 55% at 50% 100%, #000 0%, rgb(0 0 0 / 0.5) 45%, transparent 80%);
    -webkit-mask-image: radial-gradient(40% 55% at 50% 100%, #000 0%, rgb(0 0 0 / 0.5) 45%, transparent 80%);
    opacity: 0.7;
  }
  @keyframes breathe {
    from { transform: scale(1, 0.94); opacity: 0.92; }
    to { transform: scale(1.04, 1.06); opacity: 1; }
  }
  .final__kicker {
    font-family: var(--f-mono);
    font-size: 0.75rem;
    font-weight: var(--w-medium);
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--c-on-dark-soft);
  }
  .final__title {
    max-width: 13ch;
    margin-top: 20px;
    font-size: clamp(2.6rem, 1.4rem + 5vw, 5.5rem);
    font-weight: var(--w-heavy);
    line-height: 0.98;
    letter-spacing: var(--ls-display);
  }
  .final__text { max-width: 46ch; margin-top: 24px; font-size: var(--t-lg); color: var(--c-on-dark-soft); }
  .final__ctas { display: flex; flex-wrap: wrap; justify-content: center; gap: 12px; margin-top: 40px; }
  .final__reassure {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-top: 18px;
    font-size: var(--t-xs);
    color: var(--c-on-dark-soft);
  }
  .final__reassure :global(svg) { color: var(--c-green); }
</style>
