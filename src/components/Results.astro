---
/**
 * O problema e a solução: três cards cinza, ilustração em cima, linha fina e texto alinhado à esquerda.
 */
import SectionHead from './ui/SectionHead.astro';
import { results } from '../content/site';
---

<section class="section results" id="resultados" aria-labelledby="resultados-title">
  <div class="container">
    <SectionHead eyebrow={results.eyebrow} title={results.title} lead={results.lead} id="resultados-title" />

    <ul class="results__grid snap-mobile" role="list" aria-label="Resultados">
      {results.items.map((item, i) => (
        <li class:list={['card', `card--${item.id}`]} data-reveal style={`--i:${i}`}>
          <div class="card__art">
            <img
              src={`${item.image}.webp?v=5`}
              srcset={`${item.image}.webp?v=5 1x, ${item.image}@2x.webp?v=5 2x`}
              width="660"
              height="568"
              alt=""
              loading="lazy"
              decoding="async"
            />
          </div>
          <div class="card__body">
            <h3 class="card__title">{item.title}</h3>
            <p class="card__text">{item.text}</p>
          </div>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  /* Título desta seção mais leve, como no layout novo */
  .results :global(.sh__title) { max-width: 20ch; font-weight: var(--w-medium); }

  .results__grid { display: grid; gap: 20px; }
  @media (min-width: 860px) {
    .results__grid { grid-template-columns: repeat(3, 1fr); gap: 24px; }
  }
  .card {
    display: flex;
    flex-direction: column;
    border-radius: 20px;
    background: #ecebe7; /* mesmo fundo das ilustrações */
    overflow: hidden;
  }
  /* Só a ilustração aproxima de leve ao passar o mouse (fica dentro do card, não empurra nada) */
  @media (hover: hover) {
    .card:hover .card__art img { transform: scale(1.04); }
  }
  .card__art { aspect-ratio: 660 / 568; overflow: hidden; }
  .card__art img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    transition: transform var(--d-slow) var(--ease-out);
  }
  .card__body {
    flex: 1;
    padding: 24px 24px 28px;
    border-top: 1px solid rgb(13 15 13 / 0.08);
  }
  .card__title {
    font-size: clamp(1.25rem, 1.1rem + 0.4vw, 1.5rem);
    font-weight: var(--w-medium);
    line-height: 1.2;
    letter-spacing: var(--ls-title);
  }
  .card__text { margin-top: 12px; font-size: var(--t-md); line-height: 1.55; color: var(--c-ink-soft); }
</style>
